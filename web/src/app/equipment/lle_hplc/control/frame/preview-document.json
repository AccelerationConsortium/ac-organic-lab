panel); cursor: pointer; }\n    #chemstation-acquisition button.cs-primary { background: var(--cs-accent); color: var(--cs-on-accent); border-color: var(--cs-accent); }\n    #chemstation-acquisition button:disabled { background: var(--cs-bg); color: var(--cs-muted); border-color: var(--cs-border); cursor: default; }\n    #chemstation-acquisition .cs-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: 18px; }\n    #chemstation-acquisition .cs-check { display: flex; gap: 9px; align-items: start; margin-top: 18px; cursor: pointer; }\n    #chemstation-acquisition input[type=&quot;checkbox&quot;] { margin-top: 4px; accent-color: var(--cs-accent); }\n    #chemstation-acquisition .cs-notice { border-left: 3px solid var(--cs-accent); background: var(--cs-soft); padding: 12px 14px; margin-top: 18px; display: grid; gap: 6px; }\n    #chemstation-acquisition .cs-notice[data-tone=&quot;warning&quot;] { border-color: var(--cs-warning); background: var(--cs-warning-bg); }\n    #chemstation-acquisition .cs-gates { list-style: none; padding: 0; margin: 16px 0 0; }\n    #chemstation-acquisition .cs-gates li { display: flex; align-items: start; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--cs-border); }\n    #chemstation-acquisition .cs-gates li:last-child { border: 0; }\n    #chemstation-acquisition .cs-glyph { color: var(--cs-accent); flex: 0 0 18px; }\n    #chemstation-acquisition .cs-glyph[data-blocked=&quot;true&quot;] { color: var(--cs-warning); }\n    #chemstation-acquisition .cs-gates span:last-child { display: grid; gap: 3px; }\n    #chemstation-acquisition dl { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 12px; margin: 18px 0 0; }\n    #chemstation-acquisition dt { color: var(--cs-muted); }\n    #chemstation-acquisition dd { margin: 0; text-align: right; overflow-wrap: anywhere; }\n    #chemstation-acquisition .cs-history { grid-column: 1 / -1; }\n    #chemstation-acquisition .cs-history ol { padding: 0; list-style: none; margin: 16px 0 0; display: grid; gap: 12px; }\n    #chemstation-acquisition .cs-history li { display: grid; grid-template-columns: 75px minmax(0,1fr); gap: 14px; }\n    #chemstation-acquisition .cs-history time { color: var(--cs-muted); font-variant-numeric: tabular-nums; }\n    #chemstation-acquisition .cs-foot { margin-top: 12px; }\n    #chemstation-acquisition[data-compact=&quot;true&quot;] .cs-section { padding: 14px; }\n    @media (max-width: 680px) {\n      #chemstation-acquisition .cs-main { grid-template-columns: minmax(0, 1fr); padding: 16px; }\n      #chemstation-acquisition .cs-header, #chemstation-acquisition .cs-preview { padding: 16px; }\n      #chemstation-acquisition .cs-grid { grid-template-columns: minmax(0, 1fr); }\n    }\n    @media (pointer: coarse) {\n      #chemstation-acquisition button, #chemstation-acquisition select, #chemstation-acquisition .cs-check { min-height: 44px; }\n    }\n  &lt;/style&gt;\n  &lt;div class=&quot;cs-preview&quot;&gt;\n    &lt;span class=&quot;cs-muted&quot;&gt;Design preview · simulated data&lt;/span&gt;\n    &lt;label&gt;Scenario\n      &lt;select id=&quot;cs-scenario&quot; aria-label=&quot;Preview scenario&quot;&gt;\n        &lt;option value=&quot;draft&quot;&gt;Configure a run&lt;/option&gt;\n        &lt;option value=&quot;configured&quot;&gt;Ready to start&lt;/option&gt;\n        &lt;option value=&quot;running&quot;&gt;Acquiring&lt;/option&gt;\n        &lt;option value=&quot;uncertain&quot;&gt;Start outcome unknown&lt;/option&gt;\n        &lt;option value=&quot;stale&quot;&gt;Observation lost&lt;/option&gt;\n        &lt;option value=&quot;completed&quot;&gt;Completed&lt;/option&gt;\n        &lt;option value=&quot;monitor&quot;&gt;Current monitor capability&lt;/option&gt;\n      &lt;/select&gt;\n    &lt;/label&gt;\n  &lt;/div&gt;\n  &lt;header class=&quot;cs-header&quot;&gt;\n    &lt;p class=&quot;cs-muted&quot;&gt;Process Chemistry / Equipment&lt;/p&gt;\n    &lt;div class=&quot;cs-heading&quot;&gt;\n      &lt;div&gt;&lt;h2&gt;HPLC acquisition&lt;/h2&gt;&lt;p class=&quot;cs-muted cs-foot&quot;&gt;ChemStation · single injection&lt;/p&gt;&lt;/div&gt;\n      &lt;span class=&quot;cs-tag&quot; id=&quot;cs-status&quot; role=&quot;status&quot;&gt;Draft&lt;/span&gt;\n    &lt;/div&gt;\n    &lt;ol class=&quot;cs-steps&quot; aria-label=&quot;Run workflow&quot;&gt;\n      &lt;li data-step=&quot;1&quot; aria-current=&quot;step&quot;&gt;&lt;span class=&quot;cs-number&quot;&gt;1&lt;/span&gt;Configure&lt;/li&gt;\n      &lt;li data-step=&quot;2&quot;&gt;&lt;span class=&quot;cs-number&quot;&gt;2&lt;/span&gt;Start&lt;/li&gt;\n      &lt;li data-step=&quot;3&quot;&gt;&lt;span class=&quot;cs-number&quot;&gt;3&lt;/span&gt;Monitor&lt;/li&gt;\n    &lt;/ol&gt;\n  &lt;/header&gt;\n  &lt;div class=&quot;cs-main&quot;&gt;\n    &lt;section class=&quot;cs-panel&quot; aria-label=&quot;Run configuration&quot;&gt;\n      &lt;div class=&quot;cs-section&quot;&gt;\n        &lt;h3 id=&quot;cs-form-title&quot;&gt;Run configuration&lt;/h3&gt;\n        &lt;p class=&quot;cs-muted cs-foot&quot; id=&quot;cs-plan-note&quot;&gt;Demonstration plan · injection 1 · approved fixture&lt;/p&gt;\n        &lt;form id=&quot;cs-form&quot;&gt;\n          &lt;div class=&quot;cs-grid&quot;&gt;\n            &lt;label class=&quot;cs-field cs-wide&quot;&gt;Acquisition method\n              &lt;select id=&quot;cs-method&quot;&gt;&lt;option value=&quot;demo-r3&quot;&gt;Demo acquisition · revision 3&lt;/option&gt;&lt;/select&gt;\n            &lt;/label&gt;\n            &lt;label class=&quot;cs-field cs-wide&quot;&gt;Sample ID&lt;input id=&quot;cs-sample&quot; value=&quot;DEMO-014&quot; required maxlength=&quot;64&quot; pattern=&quot;[A-Za-z0-9_\\-]+&quot;&gt;&lt;/label&gt;\n            &lt;label class=&quot;cs-field&quot;&gt;Vial position&lt;input id=&quot;cs-vial&quot; type=&quot;number&quot; value=&quot;14&quot; min=&quot;1&quot; max=&quot;100&quot; step=&quot;1&quot; required&gt;&lt;/label&gt;\n            &lt;label class=&quot;cs-field&quot;&gt;Injection volume (µL)&lt;input id=&quot;cs-volume&quot; type=&quot;number&quot; value=&quot;1.0&quot; min=&quot;0.1&quot; max=&quot;10&quot; step=&quot;0.1&quot; required&gt;&lt;/label&gt;\n          &lt;/div&gt;\n          &lt;p class=&quot;cs-muted cs-foot&quot; id=&quot;cs-field-note&quot;&gt;Example values and limits for this preview.&lt;/p&gt;\n          &lt;label class=&quot;cs-check&quot; id=&quot;cs-physical-row&quot;&gt;&lt;input id=&quot;cs-physical&quot; type=&quot;checkbox&quot;&gt;&lt;span&gt;Physical setup checked against this plan, including sample and vial position.&lt;/span&gt;&lt;/label&gt;\n          &lt;div class=&quot;cs-notice&quot; id=&quot;cs-notice&quot; aria-live=&quot;polite&quot;&gt;\n            &lt;strong id=&quot;cs-notice-title&quot;&gt;Prepare a configuration preview&lt;/strong&gt;\n            &lt;span id=&quot;cs-notice-detail&quot;&gt;Review the exact run before applying settings.&lt;/span&gt;\n          &lt;/div&gt;\n          &lt;div class=&quot;cs-actions&quot;&gt;\n            &lt;button type=&quot;button&quot; id=&quot;cs-back&quot; hidden&gt;Back&lt;/button&gt;\n            &lt;button type=&quot;button&quot; class=&quot;cs-primary&quot; id=&quot;cs-action&quot;&gt;Review configuration&lt;/button&gt;\n          &lt;/div&gt;\n        &lt;/form&gt;\n      &lt;/div&gt;\n      &lt;div class=&quot;cs-section&quot; id=&quot;cs-observation&quot; hidden&gt;\n        &lt;h3&gt;Run observation&lt;/h3&gt;\n        &lt;dl&gt;&lt;dt&gt;Native phase&lt;/dt&gt;&lt;dd id=&quot;cs-phase&quot;&gt;—&lt;/dd&gt;&lt;dt&gt;Injection&lt;/dt&gt;&lt;dd id=&quot;cs-injection&quot;&gt;—&lt;/dd&gt;&lt;dt&gt;Last evidence&lt;/dt&gt;&lt;dd id=&quot;cs-evidence-time&quot;&gt;—&lt;/dd&gt;&lt;dt&gt;Outcome&lt;/dt&gt;&lt;dd id=&quot;cs-outcome&quot;&gt;Not established&lt;/dd&gt;&lt;/dl&gt;\n      &lt;/div&gt;\n    &lt;/section&gt;\n    &lt;aside class=&quot;cs-panel&quot; aria-label=&quot;Run readiness&quot;&gt;\n      &lt;div class=&quot;cs-section&quot;&gt;\n        &lt;h3 id=&quot;cs-gates-title&quot;&gt;Before applying&lt;/h3&gt;\n        &lt;p class=&quot;cs-muted cs-foot&quot; id=&quot;cs-freshness&quot;&gt;Demo observation · 2 seconds old&lt;/p&gt;\n        &lt;ul class=&quot;cs-gates&quot; id=&quot;cs-gates&quot;&gt;&lt;/ul&gt;\n      &lt;/div&gt;\n      &lt;div class=&quot;cs-section&quot;&gt;\n        &lt;h3&gt;Run record&lt;/h3&gt;\n        &lt;dl&gt;&lt;dt&gt;Run&lt;/dt&gt;&lt;dd&gt;DEMO-RUN-014&lt;/dd&gt;&lt;dt&gt;Configuration&lt;/dt&gt;&lt;dd id=&quot;cs-revision&quot;&gt;Draft&lt;/dd&gt;&lt;dt&gt;Control&lt;/dt&gt;&lt;dd id=&quot;cs-owner&quot;&gt;Demo operator&lt;/dd&gt;&lt;/dl&gt;\n        &lt;p class=&quot;cs-muted cs-foot&quot; id=&quot;cs-local-note&quot;&gt;One injection. A new run needs its own reviewed configuration.&lt;/p&gt;\n      &lt;/div&gt;\n    &lt;/aside&gt;\n    &lt;section class=&quot;cs-panel cs-history&quot; aria-label=&quot;Run event history&quot;&gt;\n      &lt;div class=&quot;cs-section&quot;&gt;&lt;h3&gt;Event history&lt;/h3&gt;&lt;ol id=&quot;cs-events&quot; aria-live=&quot;polite&quot;&gt;&lt;/ol&gt;&lt;/div&gt;\n    &lt;/section&gt;\n  &lt;/div&gt;\n  &lt;script&gt;\n    (() =&gt; {\n      const root = document.getElementById(&#x27;chemstation-acquisition&#x27;);\n      const q = s =&gt; root.querySelector(s);\n      const ui = { state: &#x27;draft&#x27;, compact: false, history: true };\n      let timer = null;\n      let events = [[&#x27;10:42:00&#x27;, &#x27;Draft created from demonstration plan.&#x27;]];\n      const labels = { draft:&#x27;Draft&#x27;, review:&#x27;Review configuration&#x27;, apply_pending:&#x27;Applying configuration&#x27;, configured:&#x27;Configured&#x27;, start_review:&#x27;Review start&#x27;, start_pending:&#x27;Start requested&#x27;, running:&#x27;Acquiring&#x27;, uncertain:&#x27;Outcome unknown&#x27;, stale:&#x27;Observation unavailable&#x27;, completed:&#x27;Completed&#x27;, monitor:&#x27;Monitoring only&#x27; };\n      const descriptions = {\n        draft: [&#x27;Prepare a configuration preview&#x27;, &#x27;Review the exact run before applying settings.&#x27;],\n        review: [&#x27;Apply this configuration&#x27;, &#x27;Applying the approved method can change instrument settings. It does not start injection.&#x27;],\n        apply_pending: [&#x27;Waiting for configuration readback&#x27;, &#x27;The request was accepted. Configuration is not yet verified.&#x27;],\n        configured: [&#x27;Configuration verified&#x27;, &#x27;Review the injection details before starting.&#x27;],\n        start_review: [&#x27;Confirm one injection&#x27;, &#x27;Start will inject the sample shown above using this verified configuration.&#x27;],\n        start_pending: [&#x27;Waiting for acquisition evidence&#x27;, &#x27;Start was accepted. Injection has not yet been confirmed.&#x27;],\n        running: [&#x27;Acquisition confirmed&#x27;, &#x27;This native injection is correlated to DEMO-RUN-014.&#x27;],\n        uncertain: [&#x27;Start outcome is unknown&#x27;, &#x27;The response was lost after dispatch. Do not start again. Operator reconciliation is required.&#x27;],\n        stale: [&#x27;Current activity is unknown&#x27;, &#x27;Last confirmed acquiring at 10:42:16. Lost observation does not mean the run stopped.&#x27;],\n        completed: [&#x27;Acquisition completed&#x27;, &#x27;A correlated native terminal event confirms completion.&#x27;],\n        monitor: [&#x27;Control is not available&#x27;, &#x27;Validated method identity, full queue occupancy, and run correlation are required.&#x27;]\n      };\n      const actionLabels = { draft:&#x27;Review configuration&#x27;, review:&#x27;Apply configuration&#x27;, apply_pending:&#x27;Verifying configuration…&#x27;, configured:&#x27;Review start&#x27;, start_review:&#x27;Confirm start&#x27;, start_pending:&#x27;Awaiting acquisition…&#x27;, running:&#x27;Run in progress&#x27;, uncertain:&#x27;Start unavailable&#x27;, stale:&#x27;Start unavailable&#x27;, completed:&#x27;Run completed&#x27;, monitor:&#x27;Configuration unavailable&#x27; };\n      function appendEvent(text) { events.push([&#x27;10:42:&#x27; + String(Math.min(59, events.length * 4)).padStart(2, &#x27;0&#x27;), text]); }\n      function matchesPlan() { return q(&#x27;#cs-sample&#x27;).value === &#x27;DEMO-014&#x27; &amp;&amp; Number(q(&#x27;#cs-vial&#x27;).value) === 14 &amp;&amp; Number(q(&#x27;#cs-volume&#x27;).value) === 1 &amp;&amp; q(&#x27;#cs-method&#x27;).value === &#x27;demo-r3&#x27;; }\n      function render() {\n        const s = ui.state;\n        const currentMonitor = s === &#x27;monitor&#x27;;\n        const isUncertain = [&#x27;uncertain&#x27;,&#x27;stale&#x27;,&#x27;monitor&#x27;].includes(s);\n        const progressed = [&#x27;start_pending&#x27;,&#x27;running&#x27;,&#x27;uncertain&#x27;,&#x27;stale&#x27;,&#x27;completed&#x27;].includes(s);\n        const editable = s === &#x27;draft&#x27;;\n        const authorized = matchesPlan();\n        root.dataset.compact = String(ui.compact);\n        q(&#x27;.cs-history&#x27;).hidden = !ui.history;\n        q(&#x27;#cs-status&#x27;).textContent = labels[s];\n        q(&#x27;#cs-status&#x27;).dataset.tone = isUncertain ? &#x27;warning&#x27; : &#x27;normal&#x27;;\n        const step = progressed ? 3 : [&#x27;configured&#x27;,&#x27;start_review&#x27;].includes(s) ? 2 : 1;\n        root.querySelectorAll(&#x27;[data-step]&#x27;).forEach(el =&gt; { if (Number(el.dataset.step) === step) el.setAttribute(&#x27;aria-current&#x27;,&#x27;step&#x27;); else el.removeAttribute(&#x27;aria-current&#x27;); });\n        [&#x27;sample&#x27;,&#x27;method&#x27;,&#x27;vial&#x27;,&#x27;volume&#x27;].forEach(id =&gt; { q(&#x27;#cs-&#x27; + id).disabled = !editable; });\n        q(&#x27;#cs-physical-row&#x27;).hidden = progressed || currentMonitor;\n        q(&#x27;#cs-physical&#x27;).disabled = [&#x27;review&#x27;,&#x27;apply_pending&#x27;,&#x27;start_review&#x27;].includes(s);\n        q(&#x27;#cs-notice&#x27;).dataset.tone = isUncertain ? &#x27;warning&#x27; : &#x27;normal&#x27;;\n        q(&#x27;#cs-notice-title&#x27;).textContent = descriptions[s][0];\n        q(&#x27;#cs-notice-detail&#x27;).textContent = descriptions[s][1];\n        const needsSetup = [&#x27;draft&#x27;,&#x27;configured&#x27;].includes(s) &amp;&amp; !q(&#x27;#cs-physical&#x27;).checked;\n        q(&#x27;#cs-action&#x27;).textContent = actionLabels[s];\n        q(&#x27;#cs-action&#x27;).disabled = needsSetup || (s !== &#x27;draft&#x27; &amp;&amp; !authorized) || ![&#x27;draft&#x27;,&#x27;review&#x27;,&#x27;configured&#x27;,&#x27;start_review&#x27;].includes(s);\n        q(&#x27;#cs-plan-note&#x27;).textContent = authorized ? &#x27;Demonstration plan · injection 1 · approved fixture&#x27; : &#x27;Edited specification · plan approval required&#x27;;\n        q(&#x27;#cs-back&#x27;).hidden = ![&#x27;review&#x27;,&#x27;start_review&#x27;].includes(s);\n        q(&#x27;#cs-back&#x27;).textContent = s === &#x27;review&#x27; ? &#x27;Edit configuration&#x27; : &#x27;Back&#x27;;\n        if (needsSetup) q(&#x27;#cs-notice-detail&#x27;).textContent = &#x27;Confirm physical setup before continuing.&#x27;;\n        if (!authorized &amp;&amp; s === &#x27;review&#x27;) { q(&#x27;#cs-notice-detail&#x27;).textContent = &#x27;This configuration differs from the approved plan. Applying is unavailable until the changed specification is approved.&#x27;; q(&#x27;#cs-notice&#x27;).dataset.tone = &#x27;warning&#x27;; }\n        q(&#x27;#cs-observation&#x27;).hidden = !progressed;\n        q(&#x27;#cs-phase&#x27;).textContent = { running:&#x27;RUN&#x27;, stale:&#x27;Unknown · last RUN&#x27;, completed:&#x27;Terminal event&#x27;, uncertain:&#x27;Unknown&#x27;, start_pending:&#x27;Not yet observed&#x27; }[s] || &#x27;—&#x27;;\n        q(&#x27;#cs-injection&#x27;).textContent = [&#x27;running&#x27;,&#x27;stale&#x27;,&#x27;completed&#x27;].includes(s) ? &#x27;1 of 1&#x27; : &#x27;Not confirmed&#x27;;\n        q(&#x27;#cs-evidence-time&#x27;).textContent = s === &#x27;completed&#x27; ? &#x27;10:55:20 · confirmed&#x27; : [&#x27;running&#x27;,&#x27;stale&#x27;].includes(s) ? &#x27;10:42:16&#x27; : &#x27;Not established&#x27;;\n        q(&#x27;#cs-outcome&#x27;).textContent = s === &#x27;completed&#x27; ? &#x27;Completed&#x27; : isUncertain ? &#x27;Unknown&#x27; : &#x27;Not established&#x27;;\n        q(&#x27;#cs-gates-title&#x27;).textContent = progressed ? &#x27;Acquisition context&#x27; : step === 2 ? &#x27;Before starting&#x27; : &#x27;Before applying&#x27;;\n        q(&#x27;#cs-freshness&#x27;).textContent = s === &#x27;stale&#x27; ? &#x27;Last observation · 90 seconds ago&#x27; : s === &#x27;completed&#x27; ? &#x27;Terminal evidence · 10:55:20&#x27; : currentMonitor ? &#x27;Current reader capability&#x27; : &#x27;Demo observation · 2 seconds old&#x27;;\n        const gates = currentMonitor ? [\n          [true,&#x27;Acquisition state&#x27;,&#x27;Read-only status supported&#x27;], [false,&#x27;Method identity&#x27;,&#x27;Not established by current reader&#x27;], [false,&#x27;Queue occupancy&#x27;,&#x27;Unknown; processing enabled is insufficient&#x27;], [false,&#x27;Run correlation&#x27;,&#x27;Not validated&#x27;], [false,&#x27;Control capability&#x27;,&#x27;Not enabled&#x27;]\n        ] : progressed ? [\n          [true,&#x27;Approved configuration&#x27;,&#x27;Demo acquisition · revision 3&#x27;], [true,&#x27;Instrument reserved&#x27;,&#x27;Reservation survives claim expiry&#x27;], [!isUncertain,&#x27;Run correlation&#x27;,isUncertain ? &#x27;New evidence required&#x27; : &#x27;Native evidence matched to this run&#x27;], [s !== &#x27;stale&#x27;,&#x27;Observation&#x27;,s === &#x27;stale&#x27; ? &#x27;Stale; current activity unknown&#x27; : &#x27;Timestamped evidence&#x27;], [s === &#x27;completed&#x27;,&#x27;Outcome&#x27;,s === &#x27;completed&#x27; ? &#x27;Native completion verified&#x27; : &#x27;No terminal result yet&#x27;]\n        ] : [\n          [authorized,&#x27;Plan authorization&#x27;,authorized ? &#x27;Verified for this demo specification&#x27; : &#x27;Edited specification needs approval&#x27;], [true,&#x27;Instrument claim&#x27;,&#x27;Held by demo operator&#x27;], [true,&#x27;Native state&#x27;,&#x27;Ready; reviewed session&#x27;], [true,&#x27;Native queue&#x27;,&#x27;Verified empty in this scenario&#x27;], [q(&#x27;#cs-physical&#x27;).checked,&#x27;Physical setup&#x27;,q(&#x27;#cs-physical&#x27;).checked ? &#x27;Operator confirmation recorded&#x27; : &#x27;Confirmation required&#x27;]\n        ];\n        q(&#x27;#cs-gates&#x27;).replaceChildren(...gates.map(([ok, title, detail]) =&gt; {\n          const li = document.createElement(&#x27;li&#x27;);\n          const glyph = document.createElement(&#x27;span&#x27;); glyph.className = &#x27;cs-glyph&#x27;; glyph.dataset.blocked = String(!ok); glyph.textContent = ok ? &#x27;✓&#x27; : &#x27;–&#x27;; glyph.setAttribute(&#x27;aria-hidden&#x27;,&#x27;true&#x27;);\n          const content = document.createElement(&#x27;span&#x27;); const name = document.createElement(&#x27;strong&#x27;); name.textContent = title; const note = document.createElement(&#x27;span&#x27;); note.className = &#x27;cs-muted&#x27;; note.textContent = detail;\n          content.append(name,note); li.append(glyph,content); return li;\n        }));\n        q(&#x27;#cs-revision&#x27;).textContent = [&#x27;configured&#x27;,&#x27;start_review&#x27;, ...[&#x27;start_pending&#x27;,&#x27;running&#x27;,&#x27;uncertain&#x27;,&#x27;stale&#x27;,&#x27;completed&#x27;]].includes(s) ? &#x27;Revision 3 · frozen&#x27; : currentMonitor ? &#x27;Not observed&#x27; : s === &#x27;review&#x27; ? &#x27;Revision 3 · preview&#x27; : &#x27;Draft&#x27;;\n        q(&#x27;#cs-owner&#x27;).textContent = currentMonitor ? &#x27;Observation only&#x27; : s === &#x27;completed&#x27; ? &#x27;Run record retained&#x27; : progressed ? &#x27;Reservation retained&#x27; : &#x27;Demo operator&#x27;;\n        q(&#x27;#cs-local-note&#x27;).textContent = progressed &a