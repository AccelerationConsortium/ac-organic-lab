"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"referrer\" content=\"no-referrer\">\n<title>HPLC acquisition control preview</title>\n<style>html, body { margin: 0; background: transparent; }</style>\n</head>\n<body>\n<div id=\"chemstation-acquisition\" aria-label=\"Acquisition control design preview\">\n  <style>\n    /* Dashboard vocabulary (ac-organic-lab TileShell / TileButton / StatusPill,\n       opentrons-server gateway panel): Tailwind slate/emerald/amber/sky/rose\n       values, rounded-xl section cards, 11px uppercase section headings. */\n    #chemstation-acquisition {\n      --page: transparent; --card: #ffffff; --border: #e2e8f0; --divider: #f1f5f9;\n      --ink: #0f172a; --muted: #475569; --subtle: #64748b; --field: #ffffff; --field-border: #cbd5e1; --field-off: #f8fafc;\n      --ok-bg: #ecfdf5; --ok-border: #6ee7b7; --ok-ink: #065f46; --ok-dot: #34d399;\n      --warn-bg: #fffbeb; --warn-border: #fcd34d; --warn-ink: #78350f; --warn-dot: #f59e0b;\n      --info-bg: #f0f9ff; --info-border: #bae6fd; --info-ink: #0c4a6e; --info-dot: #0ea5e9;\n      --bad-bg: #fff1f2; --bad-border: #fda4af; --bad-ink: #be123c;\n      --chip-bg: #f1f5f9; --chip-border: #e2e8f0; --dot-off: #94a3b8;\n      --focus: #0ea5e9;\n      color: var(--ink); background: var(--page);\n      font: 12px/1.45 ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n      font-feature-settings: \"ss01\", \"cv11\";\n      max-width: 1024px; margin: 0 auto; padding: 16px 24px 24px; display: flex; flex-direction: column; gap: 16px;\n    }\n    #chemstation-acquisition[data-theme=\"dark\"] {\n      --card: #0f172a; --border: #1e293b; --divider: #1e293b;\n      --ink: #f1f5f9; --muted: #cbd5e1; --subtle: #94a3b8; --field: #020617; --field-border: #334155; --field-off: #0f172a;\n      --ok-bg: rgba(2, 44, 34, .4); --ok-border: #047857; --ok-ink: #a7f3d0;\n      --warn-bg: rgba(69, 26, 3, .3); --warn-border: #92400e; --warn-ink: #fde68a;\n      --info-bg: rgba(8, 47, 73, .3); --info-border: rgba(12, 74, 110, .5); --info-ink: #bae6fd;\n      --bad-bg: rgba(76, 5, 25, .4); --bad-border: #9f1239; --bad-ink: #fda4af;\n      --chip-bg: rgba(30, 41, 59, .2); --chip-border: #334155; --dot-off: #64748b;\n      color-scheme: dark;\n    }\n    #chemstation-acquisition * { box-sizing: border-box; }\n    #chemstation-acquisition [hidden] { display: none !important; }\n    #chemstation-acquisition h2, #chemstation-acquisition h3, #chemstation-acquisition p, #chemstation-acquisition ol, #chemstation-acquisition ul, #chemstation-acquisition dl { margin: 0; padding: 0; }\n    #chemstation-acquisition .subtle { color: var(--subtle); }\n    #chemstation-acquisition .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }\n\n    /* Cards and headings */\n    #chemstation-acquisition .card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 12px; box-shadow: 0 1px 2px rgba(0,0,0,.05); min-width: 0; }\n    #chemstation-acquisition .strip { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 8px; }\n    #chemstation-acquisition .card h3 { margin-bottom: 8px; font-size: 11px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: var(--subtle); }\n    #chemstation-acquisition .divided { margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--divider); }\n\n    /* Header strip (gateway panel header) */\n    #chemstation-acquisition header { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }\n    #chemstation-acquisition header > div:first-child { flex: 1; min-width: 0; }\n    #chemstation-acquisition h2 { font-size: 18px; line-height: 1.5; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n    #chemstation-acquisition .badges { display: flex; flex-shrink: 0; align-items: center; gap: 6px; }\n\n    /* StatusPill */\n    #chemstation-acquisition .pill { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 2px 10px; font-size: 12px; font-weight: 500; box-shadow: inset 0 0 0 1px var(--ring); background: var(--bg); color: var(--fg); white-space: nowrap; }\n    #chemstation-acquisition .pill::before { content: \"\"; width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: .7; }\n    #chemstation-acquisition .pill[data-state=\"ready\"] { --bg: #d1fae5; --fg: #064e3b; --ring: #a7f3d0; }\n    #chemstation-acquisition .pill[data-state=\"busy\"] { --bg: #e0f2fe; --fg: #0c4a6e; --ring: #bae6fd; }\n    #chemstation-acquisition .pill[data-state=\"requires_init\"] { --bg: #fef3c7; --fg: #78350f; --ring: #fde68a; }\n    #chemstation-acquisition .pill[data-state=\"unknown\"] { --bg: #f1f5f9; --fg: #334155; --ring: #e2e8f0; }\n    #chemstation-acquisition[data-theme=\"dark\"] .pill[data-state=\"ready\"] { --bg: rgba(6,78,59,.3); --fg: #a7f3d0; --ring: #065f46; }\n    #chemstation-acquisition[data-theme=\"dark\"] .pill[data-state=\"busy\"] { --bg: rgba(12,74,110,.3); --fg: #bae6fd; --ring: #075985; }\n    #chemstation-acquisition[data-theme=\"dark\"] .pill[data-state=\"requires_init\"] { --bg: rgba(120,53,15,.3); --fg: #fde68a; --ring: #92400e; }\n    #chemstation-acquisition[data-theme=\"dark\"] .pill[data-state=\"unknown\"] { --bg: rgba(30,41,59,.5); --fg: #cbd5e1; --ring: #334155; }\n\n    /* Chips (the tile's \"Read-only monitoring\" chip) */\n    #chemstation-acquisition .chip { display: inline-flex; align-items: center; height: 24px; padding: 0 8px; border-radius: 6px; border: 1px solid var(--chip-border); background: var(--chip-bg); color: var(--subtle); font-size: 10px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; white-space: nowrap; }\n    #chemstation-acquisition .chip[data-tone=\"warn\"] { border-color: var(--warn-border); background: var(--warn-bg); color: var(--warn-ink); }\n\n    /* TileButton */\n    #chemstation-acquisition button { font: inherit; display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; gap: 4px; height: 28px; padding: 0 10px; border-radius: 6px; border: 1px solid var(--chip-border); background: var(--field); color: var(--muted); font-size: 12px; font-weight: 600; cursor: pointer; transition: background-color .15s; }\n    #chemstation-acquisition button:hover:not(:disabled) { background: var(--field-off); }\n    #chemstation-acquisition button.primary { border-color: var(--ok-border); background: var(--ok-bg); color: var(--ok-ink); }\n    #chemstation-acquisition button:disabled { opacity: .4; cursor: not-allowed; }\n    #chemstation-acquisition button:focus-visible, #chemstation-acquisition input:focus-visible, #chemstation-acquisition select:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }\n\n    /* Workflow steps (PositionPill) */\n    #chemstation-acquisition .steps { display: flex; gap: 6px; list-style: none; }\n    #chemstation-acquisition .steps li { flex: 1; min-width: 0; height: 28px; display: flex; align-items: center; justify-content: center; gap: 6px; border-radius: 6px; border: 1px solid var(--chip-border); background: var(--field-off); color: var(--muted); font-size: 12px; font-weight: 600; }\n    #chemstation-acquisition .steps li[aria-current=\"step\"] { border-color: var(--ok-border); background: var(--ok-bg); color: var(--ok-ink); }\n    #chemstation-acquisition .steps li[data-done=\"true\"]::before { content: \"\u2713\"; }\n\n    /* Two-column layout: 3fr / 2fr like the gateway panel */\n    #chemstation-acquisition .columns { display: grid; gap: 16px; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); align-items: start; }\n    #chemstation-acquisition .column { display: flex; flex-direction: column; gap: 16px; min-width: 0; }\n\n    /* Form fields */\n    #chemstation-acquisition .fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }\n    #chemstation-acquisition .field { display: grid; gap: 4px; min-width: 0; color: var(--subtle); font-size: 11px; }\n    #chemstation-acquisition .wide { grid-column: 1 / -1; }\n    #chemstation-acquisition input:not([type=\"checkbox\"]), #chemstation-acquisition select { font: inherit; font-size: 12px; width: 100%; min-width: 0; height: 28px; padding: 0 8px; border-radius: 4px; border: 1px solid var(--field-border); background: var(--field); color: var(--ink); }\n    #chemstation-acquisition input:disabled, #chemstation-acquisition select:disabled { background: var(--field-off); color: var(--subtle); }\n    #chemstation-acquisition .strip select { width: auto; }\n    #chemstation-acquisition .check { display: flex; align-items: flex-start; gap: 8px; margin-top: 8px; color: var(--ink); cursor: pointer; }\n    #chemstation-acquisition input[type=\"checkbox\"] { margin: 2px 0 0; accent-color: #059669; }\n    #chemstation-acquisition .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }\n\n    /* Message bands (gateway panel amber/sky notices) */\n    #chemstation-acquisition .band { display: grid; gap: 2px; margin-top: 8px; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--info-border); background: var(--info-bg); color: var(--info-ink); }\n    #chemstation-acquisition .band[data-tone=\"warn\"] { border-color: var(--warn-border); background: var(--warn-bg); color: var(--warn-ink); }\n    #chemstation-acquisition .band strong { font-weight: 600; }\n\n    /* Key/value rows (gateway panel KV) */\n    #chemstation-acquisition .kv { display: grid; gap: 4px; }\n    #chemstation-acquisition .kv div { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }\n    #chemstation-acquisition .kv dt { color: var(--subtle); }\n    #chemstation-acquisition .kv dd { margin: 0; min-width: 0; text-align: right; overflow-wrap: anywhere; }\n\n    /* Readiness gates: toned pills with a state dot */\n    #chemstation-acquisition .gates { display: grid; gap: 6px; list-style: none; }\n    #chemstation-acquisition .gates li { display: flex; align-items: flex-start; gap: 8px; padding: 6px 8px; border-radius: 6px; border: 1px solid var(--ok-border); background: var(--ok-bg); }\n    #chemstation-acquisition .gates li[data-ok=\"false\"] { border-color: var(--chip-border); background: var(--chip-bg); }\n    #chemstation-acquisition .gates li[data-ok=\"false\"][data-warn=\"true\"] { border-color: var(--warn-border); background: var(--warn-bg); }\n    #chemstation-acquisition .dot { flex: 0 0 8px; width: 8px; height: 8px; margin-top: 4px; border-radius: 50%; background: var(--ok-dot); }\n    #chemstation-acquisition li[data-ok=\"false\"] .dot { background: var(--dot-off); }\n    #chemstation-acquisition li[data-warn=\"true\"][data-ok=\"false\"] .dot { background: var(--warn-dot); }\n    #chemstation-acquisition .gates strong { display: block; font-weight: 600; color: var(--ink); }\n    #chemstation-acquisition .gates span span { color: var(--subtle); font-size: 11px; }\n\n    /* Event history */\n    #chemstation-acquisition .events { display: grid; gap: 4px; list-style: none; }\n    #chemstation-acquisition .events li { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 12px; }\n    #chemstation-acquisition .events time { color: var(--subtle); font-variant-numeric: tabular-nums; }\n    #chemstation-acquisition .note { margin-top: 8px; font-size: 11px; color: var(--subtle); }\n\n    @media (max-width: 1023px) {\n      #chemstation-acquisition .columns { grid-template-columns: minmax(0, 1fr); }\n      #chemstation-acquisition .column { max-width: 576px; width: 100%; margin: 0 auto; }\n    }\n    @media (max-width: 640px) {\n      #chemstation-acquisition { padding: 16px; }\n      #chemstation-acquisition .fields { grid-template-columns: minmax(0, 1fr); }\n    }\n    @media (pointer: coarse) {\n      #chemstation-acquisition button, #chemstation-acquisition select, #chemstation-acquisition input:not([type=\"checkbox\"]) { min-height: 44px; }\n    }\n  </style>\n\n  <div class=\"card strip\">\n    <span class=\"chip\" data-tone=\"warn\">Design preview \u00b7 simulated data</span>\n    <span class=\"chip\">No instrument connection</span>\n    <label class=\"subtle\" style=\"margin-left:auto; display:flex; align-items:center; gap:6px\">Scenario\n      <select id=\"cs-scenario\" aria-label=\"Preview scenario\">\n        <option value=\"draft\">Configure a run</option>\n        <option value=\"configured\">Ready to start</option>\n        <option value=\"running\">Acquiring</option>\n        <option value=\"uncertain\">Start outcome unknown</option>\n        <option value=\"stale\">Observation lost</option>\n        <option value=\"completed\">Completed</option>\n        <option value=\"monitor\">Current monitor capability</option>\n      </select>\n    </label>\n  </div>\n\n  <header>\n    <div>\n      <h2>HPLC (Process Chemistry)</h2>\n      <p class=\"subtle\">HPLC \u00b7 <span class=\"mono\">lle_hplc</span> \u00b7 ChemStation \u00b7 single injection</p>\n    </div>\n    <div class=\"badges\">\n      <span class=\"pill\" id=\"cs-run-state\" role=\"status\">Draft</span>\n      <span class=\"pill\" id=\"cs-equipment\" title=\"Simulated equipment_status for this scenario\">Ready</span>\n    </div>\n  </header>\n\n  <ol class=\"steps\" aria-label=\"Run workflow\">\n    <li data-step=\"1\" aria-current=\"step\">Configure</li>\n    <li data-step=\"2\">Start</li>\n    <li data-step=\"3\">Monitor</li>\n  </ol>\n\n  <div class=\"columns\">\n    <div class=\"column\">\n      <section class=\"card\" aria-label=\"Run configuration\">\n        <h3 id=\"cs-form-title\">Run configuration</h3>\n        <p class=\"subtle\" id=\"cs-plan-note\" style=\"margin-bottom:8px\">Demonstration plan \u00b7 injection 1 \u00b7 approved fixture</p>\n        <form id=\"cs-form\">\n          <div class=\"fields\">\n            <label class=\"field wide\">Acquisition method\n              <select id=\"cs-method\"><option value=\"demo-r3\">Demo acquisition \u00b7 revision 3</option></select>\n            </label>\n            <label class=\"field wide\">Sample ID<input id=\"cs-sample\" value=\"DEMO-014\" required maxlength=\"64\" pattern=\"[A-Za-z0-9_\\-]+\"></label>\n            <label class=\"field\">Vial position<input id=\"cs-vial\" type=\"number\" value=\"14\" min=\"1\" max=\"100\" step=\"1\" required></label>\n            <label class=\"field\">Injection volume (\u00b5L)<input id=\"cs-volume\" type=\"number\" value=\"1.0\" min=\"0.1\" max=\"10\" step=\"0.1\" required></label>\n          </div>\n          <p class=\"note\" id=\"cs-field-note\">Example values and limits for this preview.</p>\n          <label class=\"check\" id=\"cs-physical-row\"><input id=\"cs-physical\" type=\"checkbox\"><span>Physical setup checked against this plan, including sample and vial position.</span></label>\n          <div class=\"band\" id=\"cs-notice\" aria-live=\"polite\">\n            <strong id=\"cs-notice-title\">Prepare a configuration preview</strong>\n            <span id=\"cs-notice-detail\">Review the exact run before applying settings.</span>\n          </div>\n          <div class=\"actions divided\">\n            <button type=\"button\" id=\"cs-back\" hidden>Back</button>\n            <button type=\"button\" class=\"primary\" id=\"cs-action\">Review configuration</button>\n          </div>\n        </form>\n      </section>\n\n      <section class=\"card\" id=\"cs-observation\" aria-label=\"Run observation\" hidden>\n        <h3>Run observation</h3>\n        <dl class=\"kv\">\n          <div><dt>Native phase</dt><dd class=\"mono\" id=\"cs-phase\">\u2014</dd></div>\n          <div><dt>Injection</dt><dd id=\"cs-injection\">\u2014</dd></div>\n          <div><dt>Last evidence</dt><dd class=\"mono\" id=\"cs-evidence-time\">\u2014</dd></div>\n          <div><dt>Outcome</dt><dd id=\"cs-outcome\">Not established</dd></div>\n        </dl>\n      </section>\n    </div>\n\n    <div class=\"column\">\n      <section class=\"card\" aria-label=\"Run readiness\">\n        <h3 id=\"cs-gates-title\">Before applying</h3>\n        <p class=\"subtle\" id=\"cs-freshness\" style=\"margin-bottom:8px\">Demo observation \u00b7 2 seconds old</p>\n        <ul class=\"gates\" id=\"cs-gates\"></ul>\n      </section>\n\n      <section class=\"card\" aria-label=\"Run record\">\n        <h3>Run record</h3>\n        <dl class=\"kv\">\n          <div><dt>Run</dt><dd class=\"mono\">DEMO-RUN-014</dd></div>\n          <div><dt>Configuration</dt><dd id=\"cs-revision\">Draft</dd></div>\n          <div><dt>Control</dt><dd id=\"cs-owner\">Demo operator</dd></div>\n        </dl>\n        <p class=\"note divided\" id=\"cs-local-note\">One injection. A new run needs its own reviewed configuration.</p>\n      </section>\n\n      <section class=\"card\" aria-label=\"Run event history\">\n        <h3>Event history</h3>\n        <ol class=\"events\" id=\"cs-events\" aria-live=\"polite\"></ol>\n      </section>\n    </div>\n  </div>\n\n  <script>\n    (() => {\n      const root = document.getElementById('chemstation-acquisition');\n      const q = s => root.querySelector(s);\n      // The host page passes its theme in the fragment (#theme=dark); a\n      // sandboxed frame cannot read the dashboard's own theme setting.\n      const hinted = /(?:^|[#&])theme=(dark|light)\\b/.exec(location.hash);\n      root.dataset.theme = hinted ? hinted[1] : (globalThis.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');\n      const ui = { state: 'draft' };\n      let timer = null;\n      let events = [['10:42:00', 'Draft created from demonstration plan.']];\n      const labels = { draft:'Draft', review:'Review configuration', apply_pending:'Applying configuration', configured:'Configured', start_review:'Review start', start_pending:'Start requested', running:'Acquiring', uncertain:'Outcome unknown', stale:'Observation unavailable', completed:'Completed', monitor:'Monitoring only' };\n      // Pill tone for the run state, in the dashboard's StatusPill palette.\n      const runTone = { draft:'unknown', review:'unknown', apply_pending:'busy', configured:'ready', start_review:'ready', start_pending:'busy', running:'busy', uncertain:'requires_init', stale:'requires_init', completed:'ready', monitor:'unknown' };\n      // Simulated top-level equipment_status for each scenario.\n      const equipment = { draft:['ready','Ready'], review:['ready','Ready'], apply_pending:['ready','Ready'], configured:['ready','Ready'], start_review:['ready','Ready'], start_pending:['busy','Busy'], running:['busy','Busy'], uncertain:['unknown','Unknown'], stale:['unknown','Unknown'], completed:['ready','Ready'], monitor:['requires_init','Needs init'] };\n      const descriptions = {\n        draft: ['Prepare a configuration preview', 'Review the exact run before applying settings.'],\n        review: ['Apply this configuration', 'Applying the approved method can change instrument settings. It does not start injection.'],\n        apply_pending: ['Waiting for configuration readback', 'The request was accepted. Configuration is not yet verified.'],\n        configured: ['Configuration verified', 'Review the injection details before starting.'],\n        start_review: ['Confirm one injection', 'Start will inject the sample shown above using this verified configuration.'],\n        start_pending: ['Waiting for acquisition evidence', 'Start was accepted. Injection has not yet been confirmed.'],\n        running: ['Acquisition confirmed', 'This native injection is correlated to DEMO-RUN-014.'],\n        uncertain: ['Start outcome is unknown', 'The response was lost after dispatch. Do not start again. Operator reconciliation is required.'],\n        stale: ['Current activity is unknown', 'Last confirmed acquiring at 10:42:16. Lost observation does not mean the run stopped.'],\n        completed: ['Acquisition completed', 'A correlated native terminal event confirms completion.'],\n        monitor: ['Control is not available', 'Validated method identity, full queue occupancy, and run correlation are required.']\n      };\n      const actionLabels = { draft:'Review configuration', review:'Apply configuration', apply_pending:'Verifying configuration\u2026', configured:'Review start', start_review:'Confirm start', start_pending:'Awaiting acquisition\u2026', running:'Run in progress', uncertain:'Start unavailable', stale:'Start unavailable', completed:'Run completed', monitor:'Configuration unavailable' };\n      function appendEvent(text) { events.push(['10:42:' + String(Math.min(59, events.length * 4)).padStart(2, '0'), text]); }\n      function matchesPlan() { return q('#cs-sample').value === 'DEMO-014' && Number(q('#cs-vial').value) === 14 && Number(q('#cs-volume').value) === 1 && q('#cs-method').value === 'demo-r3'; }\n      function render() {\n        const s = ui.state;\n        const currentMonitor = s === 'monitor';\n        const isUncertain = ['uncertain','stale','monitor'].includes(s);\n        const progressed = ['start_pending','running','uncertain','stale','completed'].includes(s);\n        const editable = s === 'draft';\n        const authorized = matchesPlan();\n        q('#cs-run-state').textContent = labels[s];\n        q('#cs-run-state').dataset.state = runTone[s];\n        q('#cs-equipment').dataset.state = equipment[s][0];\n        q('#cs-equipment').textContent = equipment[s][1];\n        const step = progressed ? 3 : ['configured','start_review'].includes(s) ? 2 : 1;\n        root.querySelectorAll('[data-step]').forEach(el => {\n          const n = Number(el.dataset.step);\n          if (n === step) el.setAttribute('aria-current','step'); else el.removeAttribute('aria-current');\n          el.dataset.done = String(n < step || (s === 'completed' && n === 3));\n        });\n        ['sample','method','vial','volume'].forEach(id => { q('#cs-' + id).disabled = !editable; });\n        q('#cs-physical-row').hidden = progressed || currentMonitor;\n        q('#cs-physical').disabled = ['review','apply_pending','start_review'].includes(s);\n        q('#cs-notice').dataset.tone = isUncertain ? 'warn' : 'info';\n        q('#cs-notice-title').textContent = descriptions[s][0];\n        q('#cs-notice-detail').textContent = descriptions[s][1];\n        const needsSetup = ['draft','configured'].includes(s) && !q('#cs-physical').checked;\n        q('#cs-action').textContent = actionLabels[s];\n        q('#cs-action').disabled = needsSetup || (s !== 'draft' && !authorized) || !['draft','review','configured','start_review'].includes(s);\n        q('#cs-plan-note').textContent = authorized ? 'Demonstration plan \u00b7 injection 1 \u00b7 approved fixture' : 'Edited specification \u00b7 plan approval required';\n        q('#cs-back').hidden = !['review','start_review'].includes(s);\n        q('#cs-back').textContent = s === 'review' ? 'Edit configuration' : 'Back';\n        if (needsSetup) q('#cs-notice-detail').textContent = 'Confirm physical setup before continuing.';\n        if (!authorized && s === 'review') { q('#cs-notice-detail').textContent = 'This configuration differs from the approved plan. Applying is unavailable until the changed specification is approved.'; q('#cs-notice').dataset.tone = 'warn'; }\n        q('#cs-observation').hidden = !progressed;\n        q('#cs-phase').textContent = { running:'RUN', stale:'Unknown \u00b7 last RUN', completed:'Terminal event', uncertain:'Unknown', start_pending:'Not yet observed' }[s] || '\u2014';\n        q('#cs-injection').textContent = ['running','stale','completed'].includes(s) ? '1 of 1' : 'Not confirmed';\n        q('#cs-evidence-time').textContent = s === 'completed' ? '10:55:20 \u00b7 confirmed' : ['running','stale'].includes(s) ? '10:42:16' : 'Not established';\n        q('#cs-outcome').textContent = s === 'completed' ? 'Completed' : isUncertain ? 'Unknown' : 'Not established';\n        q('#cs-gates-title').textContent = progressed ? 'Acquisition context' : step === 2 ? 'Before starting' : 'Before applying';\n        q('#cs-freshness').textContent = s === 'stale' ? 'Last observation \u00b7 90 seconds ago' : s === 'completed' ? 'Terminal evidence \u00b7 10:55:20' : currentMonitor ? 'Current reader capability' : 'Demo observation \u00b7 2 seconds old';\n        // [ok, title, detail, warn] \u2014 warn marks a blocker that needs attention,\n        // not merely a capability that is absent.\n        const gates = currentMonitor ? [\n          [true,'Acquisition state','Read-only status supported'], [false,'Method identity','Not established by current reader'], [false,'Queue occupancy','Unknown; processing enabled is insufficient'], [false,'Run correlation','Not validated'], [false,'Control capability','Not enabled']\n        ] : progressed ? [\n          [true,'Approved configuration','Demo acquisition \u00b7 revision 3'], [true,'Instrument reserved','Reservation survives claim expiry'], [!isUncertain,'Run correlation',isUncertain ? 'New evidence required' : 'Native evidence matched to this run',true], [s !== 'stale','Observation',s === 'stale' ? 'Stale; current activity unknown' : 'Timestamped evidence',true], [s === 'completed','Outcome',s === 'completed' ? 'Native completion verified' : 'No terminal result yet']\n        ] : [\n          [authorized,'Plan authorization',authorized ? 'Verified for this demo specification' : 'Edited specification needs approval',true], [true,'Instrument claim','Held by demo operator'], [true,'Native state','Ready; reviewed session'], [true,'Native queue','Verified empty in this scenario'], [q('#cs-physical').checked,'Physical setup',q('#cs-physical').checked ? 'Operator confirmation recorded' : 'Confirmation required',true]\n        ];\n        q('#cs-gates').replaceChildren(...gates.map(([ok, title, detail, warn]) => {\n          const li = document.createElement('li'); li.dataset.ok = String(ok); li.da