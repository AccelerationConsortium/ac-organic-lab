# Python / uv
__pycache__/
*.py[cod]
# Both forms on purpose. `.venv/` matches only a directory, so a *symlink*
# named .venv slips past it and can be committed — and checking that symlink
# out over the real environment destroys it (it happened: a temporary
# worktree symlinked .venv so the auth pre-commit hook could find a python,
# `git add -A` staged it, and the next merge replaced this repo's venv with a
# self-referential link, leaving the api unit's ExecStart dangling).
.venv/
.venv
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Local secrets and overrides
.env
# Any separator: a `.env.bak.<stamp>` from `cp -p .env ...` slipped past the
# old `.env.bak-*` and sat untracked in the repo root with a live API key in
# it, one `git add -A` from being committed.
.env.bak*
.env.local
.env.*.local
api/.env
web/.env.local
equipment.local.yaml

# Local SQLite runtime state
data/*.db
data/*.db-shm
data/*.db-wal

# Shared deck-layout store (runtime state, written by api/app/deck.py)
data/deck_layouts.json

# Admin-uploaded labware definitions (runtime state of the labware store, next
# to lab.db). Definitions meant to be version-controlled belong in labware/,
# which the store serves as source="repo".
data/labware/

# Local runtime and deployment state
.run/
deploy/local/
.chats/

# Editors / OS
.DS_Store
.vscode/
.idea/
*.code-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Claude Code (CLAUDE.md and .claude/settings.json are committed; only personal overrides are ignored)
.claude/settings.local.json
CLAUDE.local.md

# pytest --basetemp scratch dir
.tmp_pytest/
LAAGENTEANALITICA_ASSESSMENT.md

# Stray service-topology diagram (not project source — kept local only)
ac-organic-lab-service-topology.pptx
