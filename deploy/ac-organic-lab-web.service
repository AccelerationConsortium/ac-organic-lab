# This file is the unit as DEPLOYED, not an aspiration. It previously described
# a /opt/ac-organic-lab install running as a dedicated `ac` user — a layout that
# does not exist on the dashboard host and never has, so installing it would
# have broken the service. Companion to the same fix for the API unit.
#
# The paths below are this host's (repo under /home/sdl2/caoyang). A different
# layout means changing User/Group, WorkingDirectory, EnvironmentFile, ExecStart
# and ReadWritePaths together — and relaxing ProtectHome only as far as the
# checkout's location actually requires.
#
# `HOSTNAME=0.0.0.0` is deliberate and differs from the loopback-only shape this
# file used to describe: the dashboard is reachable directly on the tailnet at
# :8000, alongside the Caddy edge on :80. Verified 2026-08-14 that this is an
# exposure choice and not an auth bypass — control writes on :8000 return 401
# (the API enforces identity itself), and `/api/equipment` reads answer 200 on
# both ports, which is the documented v1 posture (Tailscale ACLs gate access).
# Change it to 127.0.0.1 if that posture ever tightens.
[Unit]
Description=AC Organic Self-driving Lab web (Next.js standalone)
Documentation=https://github.com/AccelerationConsortium/ac-organic-lab
After=network-online.target ac-organic-lab-api.service
Wants=network-online.target
Requires=ac-organic-lab-api.service

[Service]
Type=simple
User=sdl2
Group=sdl2

# The standalone build produces a self-contained server.js at
# .next/standalone/server.js. That directory must be the working
# directory because server.js resolves static assets with process.cwd().
# Deploy step must copy .next/static and public/ into this directory.
WorkingDirectory=/home/sdl2/caoyang/ac-organic-lab/web/.next/standalone

Environment=NODE_ENV=production
Environment=PORT=3000
# HOSTNAME=0.0.0.0 binds all interfaces, including the Tailscale interface,
# so the dashboard is reachable at http://sdl2-server-gaia.tail6a1dd7.ts.net:3000
# from any other tailnet node.
Environment=HOSTNAME=0.0.0.0
Environment=DASHBOARD_API_BASE=http://127.0.0.1:8001

ExecStart=/usr/bin/node server.js

Restart=on-failure
RestartSec=3
TimeoutStopSec=10

# Logging
SyslogIdentifier=ac-organic-lab-web
StandardOutput=journal
StandardError=journal

# Resources
LimitNOFILE=65536

# Sandboxing - relaxed from canonical because the repo lives under /home.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/home/sdl2/caoyang/ac-organic-lab/web/.next

[Install]
WantedBy=multi-user.target
