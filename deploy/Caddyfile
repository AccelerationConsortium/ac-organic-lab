# Optional: front the dashboard with Caddy on the Tailscale-attached server.
# Caddy uses Tailscale's `tailscale cert` for TLS automatically when the
# hostname matches a tailnet name.
#
# Usage:
#   sudo cp Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

lab-dashboard.tail-XXXX.ts.net {
    encode gzip

    # go2rtc - WebSocket-upgrade-aware reverse proxy for the camera live
    # video stream. The browser hits `wss://<host>/streams/api/ws?src=...`;
    # Caddy forwards to go2rtc on :1984 with the WS upgrade preserved.
    handle_path /streams/* {
        reverse_proxy 127.0.0.1:1984
    }

    # The camera/plug gateway (127.0.0.1:8002) is intentionally not routed
    # here. All traffic goes through the aggregator at
    # /api/equipment/{id}/{control,media}/*, which the fallback proxy below
    # already covers. (A /api/{cameras,plugs}/* dev escape hatch used to live
    # here; it 404'd either way — the gateway mounts /cameras/… and /plugs/…
    # with no /api prefix — and shadowed those paths. Removed 2026-08-02.)

    # Next.js handles both / and /api/* (the latter via its rewrite to FastAPI).
    reverse_proxy 100.64.254.6:8000
}
