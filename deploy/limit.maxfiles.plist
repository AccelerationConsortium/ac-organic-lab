<?xml version="1.0" encoding="UTF-8"?>
<!--
Raises macOS per-process file-descriptor limit system-wide so tools like
Next.js's file watcher (and many other Node processes spawned by Cursor,
VSCode, etc.) don't hit EMFILE.

Default `launchctl limit maxfiles` on macOS is 256 / unlimited. This raises
it to 65536 / 65536.

Install:
  sudo cp deploy/limit.maxfiles.plist /Library/LaunchDaemons/limit.maxfiles.plist
  sudo chown root:wheel /Library/LaunchDaemons/limit.maxfiles.plist
  sudo chmod 644 /Library/LaunchDaemons/limit.maxfiles.plist
  sudo launchctl load -w /Library/LaunchDaemons/limit.maxfiles.plist
  # reboot for the change to affect new login sessions

After reboot, verify:
  launchctl limit maxfiles   # should show 65536 / 65536

With this in place you can remove WATCHPACK_POLLING=true from `web/package.json`
if you want to use native FSEvents (slightly lower CPU than polling).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>limit.maxfiles</string>
    <key>ProgramArguments</key>
    <array>
      <string>launchctl</string>
      <string>limit</string>
      <string>maxfiles</string>
      <string>65536</string>
      <string>65536</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>ServiceIPC</key>
    <false/>
  </dict>
</plist>
