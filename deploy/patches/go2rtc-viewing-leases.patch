+++ b/internal/webrtc/lease_test.go
@@ -0,0 +1,78 @@
+package webrtc
+
+import (
+    "encoding/json"
+    "net/http/httptest"
+    "testing"
+    "time"
+    "github.com/AlexxIT/go2rtc/internal/api/ws"
+    "github.com/AlexxIT/go2rtc/internal/streams"
+    "github.com/AlexxIT/go2rtc/pkg/core"
+    pion "github.com/pion/webrtc/v4"
+    "github.com/stretchr/testify/require"
+)
+
+type leaseProducer struct { core.Connection }
+func (*leaseProducer) Start() error { return nil }
+
+func TestCameraConsumerRemovedOnLeaseClose(t *testing.T) {
+    for _, alreadyClosed := range []bool{false,true} {
+        old:=PeerConnection
+        var server *pion.PeerConnection
+        PeerConnection=func(bool)(*pion.PeerConnection,error){var e error;server,e=pion.NewPeerConnection(pion.Configuration{});return server,e}
+        stream,err:=streams.New("lease_camera")
+        require.NoError(t,err)
+        stream.AddProducer(&leaseProducer{Connection:core.Connection{Medias:[]*core.Media{{Kind:core.KindVideo,Direction:core.DirectionRecvonly,Codecs:[]*core.Codec{{Name:core.CodecVP8,ClockRate:90000,PayloadType:96}}}}}})
+        peer,err:=pion.NewPeerConnection(pion.Configuration{})
+        require.NoError(t,err)
+        _,err=peer.AddTransceiverFromKind(pion.RTPCodecTypeVideo,pion.RTPTransceiverInit{Direction:pion.RTPTransceiverDirectionRecvonly})
+        require.NoError(t,err)
+        offer,err:=peer.CreateOffer(nil)
+        require.NoError(t,err)
+        tr:=&ws.Transport{Request:httptest.NewRequest("GET","http://localhost/api/ws?src=lease_camera",nil)}
+        tr.OnWrite(func(any)error{return nil})
+        if alreadyClosed {tr.Close()}
+        err=asyncHandler(tr,&ws.Message{Type:"webrtc/offer",Value:offer.SDP})
+        if !alreadyClosed {require.NoError(t,err);tr.Close()}
+        require.Equal(t,pion.PeerConnectionStateClosed,server.ConnectionState())
+        require.Eventually(t,func()bool{
+            raw,_:=stream.MarshalJSON()
+            var s struct{Consumers []any `json:"consumers"`}
+            _=json.Unmarshal(raw,&s)
+            return len(s.Consumers)==0
+        },time.Second,10*time.Millisecond)
+        peer.Close()
+        PeerConnection=old
+    }
+}
+
+func TestSignallingCloseEndsMedia(t *testing.T) {
+    for _, alreadyClosed := range []bool{false, true} {
+        t.Run(map[bool]string{false:"normal",true:"setup-race"}[alreadyClosed], func(t *testing.T) {
+            old := PeerConnection
+            defer func(){PeerConnection=old}()
+            var server *pion.PeerConnection
+            PeerConnection=func(bool)(*pion.PeerConnection,error){
+                var err error
+                server,err=pion.NewPeerConnection(pion.Configuration{})
+                return server,err
+            }
+            _,err:=streams.New("lease_test")
+            require.NoError(t,err)
+            peer,err:=pion.NewPeerConnection(pion.Configuration{})
+            require.NoError(t,err)
+            defer peer.Close()
+            _,err=peer.AddTransceiverFromKind(pion.RTPCodecTypeVideo)
+            require.NoError(t,err)
+            offer,err:=peer.CreateOffer(nil)
+            require.NoError(t,err)
+            tr:=&ws.Transport{Request:httptest.NewRequest("GET","http://localhost/api/ws?dst=lease_test",nil)}
+            tr.OnWrite(func(any)error{return nil})
+            if alreadyClosed {tr.Close()}
+            err=asyncHandler(tr,&ws.Message{Type:"webrtc/offer",Value:offer.SDP})
+            if !alreadyClosed { require.NoError(t,err); tr.Close() }
+            require.NotNil(t,server)
+            require.Equal(t,pion.PeerConnectionStateClosed,server.ConnectionState())
+        })
+    }
+}
