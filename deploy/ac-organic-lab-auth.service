[Unit]
Description=AC Organic Lab - Auth sidecar (ac_auth: email-code login + roster authz)
# Binds the host's Tailscale IP, so the IP must exist before bind.
After=network-online.target tailscaled.service
Wants=network-online.target
Requires=tailscaled.service

[Service]
Type=simple
User=sdl2
WorkingDirectory=/opt/ac-organic-lab/auth
EnvironmentFile=-/opt/ac-organic-lab/.env
# Dashboard is plain http over the Tailnet; flip to true once real TLS fronts it.
Environment=AUTH_COOKIE_SECURE=false
# Fail closed: validate roster.yaml before (re)starting. A broken allow-list
# aborts the start (the running instance keeps serving) rather than booting
# with a bad/empty list.
ExecStartPre=/opt/ac-organic-lab/.venv/bin/python -m ac_auth.cli validate
# Bind the host's Tailscale IP, NOT loopback: the Next.js middleware calls
# /auth/verify on it, and a remote Caddy forward_auth must reach it over the
# Tailnet (see deploy/Caddyfile.auth-snippet). Adjust the IP per host.
ExecStart=/opt/ac-organic-lab/.venv/bin/uvicorn ac_auth.main:app \
    --host 100.64.254.6 \
    --port 8009 \
    --no-server-header \
    --log-level info
# `systemctl reload` → SIGHUP → keep-last-good roster hot-reload.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
SyslogIdentifier=ac-organic-lab-auth

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
