[Unit]
Description=AC Organic Self-driving Lab API (FastAPI aggregator)
Documentation=https://github.com/AccelerationConsortium/ac-organic-lab
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=ac
Group=ac
WorkingDirectory=/opt/ac-organic-lab/api
# Optional `.env` at the repo root; not required for v1 (read-only).
EnvironmentFile=-/opt/ac-organic-lab/.env

# Reads ../equipment.yaml relative to WorkingDirectory unless LAB_REGISTRY_PATH
# is set in the EnvironmentFile.
#
# Uses the shared uv-workspace venv at the repo root (see root pyproject.toml).
# The editable install of `ac-organic-lab-dashboard-api` exposes top-level `app`
# on sys.path, so `app.main:app` resolves regardless of WorkingDirectory.
ExecStart=/opt/ac-organic-lab/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8001 \
    --no-server-header \
    --log-level info

Restart=on-failure
RestartSec=3
TimeoutStopSec=10

# Logging
SyslogIdentifier=ac-organic-lab-api
StandardOutput=journal
StandardError=journal

# Resources
LimitNOFILE=65536

# Basic systemd sandboxing. These are safe for a Python FastAPI process
# that only makes outbound HTTP to the tailnet and reads a YAML file from
# WorkingDirectory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Allow writing only to the python bytecode cache dirs under the repo.
# Both `api/` and `skills/` are needed because both are editable installs in
# the shared workspace venv, and CPython writes __pycache__/ next to source.
ReadWritePaths=/opt/ac-organic-lab/api /opt/ac-organic-lab/skills /opt/ac-organic-lab/data

[Install]
WantedBy=multi-user.target
