# Caddyfile.single-edge — the lab's single SSO edge, AS DEPLOYED.
#
# PROVENANCE: captured verbatim from the running configuration at
# /etc/dashboard-staging/Caddyfile on sdl2-orchestration, 2026-09-20.
# The file on that host is what Caddy actually serves (dashboard-edge.service
# runs `caddy run --config /etc/dashboard-staging/Caddyfile`). THE LIVE FILE IS
# AUTHORITATIVE. This copy exists so the repo records what is deployed; when
# you change the edge, patch BOTH and re-capture here, or this drifts again.
#
# It drifted badly before this capture. The previous contents of this file
# described the Phase-1 design from docs/SINGLE_EDGE_SSO_PLAN.md and had not
# kept up with the deployment; `git log -p` on this path has that version. The
# three differences that mattered, for anyone reading an older checkout:
#
#   1. SHAPE. Live serves every application route from ONE shared router at
#      http://:8080 bound to loopback, fronted by thin sites that proxy into
#      it: the tailnet IP (http://100.64.254.6), an HTTPS origin on the tailnet
#      name with a `tailscale cert`, plus standalone sites for auth (:8009) and
#      Uptime Kuma (:8005). The old file had no shared router and no HTTPS
#      origin; routes hung directly off the IP site.
#   2. /analytica MOVED AND CHANGED MEANING. Here it is the LaAgente chat app
#      on gaia (100.64.254.5:3000), with /agente kept as an alias. The old file
#      pointed the same path at AnaliticaDB's API on THIS host (:8010).
#      AnaliticaDB now answers at /analyticadb (also gaia), with /openapi.json
#      routed at the origin root because the service runs without --root-path.
#   3. ROUTES. Live additionally carries /analyticadb, /openapi.json,
#      /hermes/api/{events,pty} and a narrower /bitacora/api/inventory.
#
# Secrets are {env.*} references only; the values live in the edge's
# EnvironmentFile entries (see `systemctl cat dashboard-edge`), never here.
#
{
	admin off
	auto_https off
}

http://:8080 {
	bind 127.0.0.1
	route {
		request_header -X-Auth-User
		request_header -X-Auth-Role
		request_header -X-Auth-Projects
		request_header -X-Auth-Pi-Projects
		request_header -X-Edge-Secret


        # PyPoe web moved to this host (pypoe-web.service binds 100.64.254.6:8006);
        # gaia's copy is disabled, so /pypoe is served from here, not retained.
        # forward_auth gates every request (incl. the /ws/chat upgrade, which
        # carries the same ac_auth cookie) and injects X-Auth-User for PyPoe's
        # owner scoping. Inside this `route`, directives run in written order.
        @pypoe path /pypoe /pypoe/*
        handle @pypoe {
            redir /pypoe /pypoe/ 308
            forward_auth 127.0.0.1:8009 {
                uri /auth/verify
                copy_headers X-Auth-User X-Auth-Role
            }
            handle_path /pypoe/* {
                reverse_proxy 100.64.254.6:8006 {
                    header_up X-Forwarded-Prefix /pypoe
                }
            }
        }
        # PyPoe React UI (pypoe-web-next.service, loopback :8007; VITE_BASE is
        # baked as /pypoe-next/ so no prefix header is needed). Moved here from
        # gaia 2026-09-18; same auth gate as /pypoe.
        @pypoe_next path /pypoe-next /pypoe-next/*
        handle @pypoe_next {
            redir /pypoe-next /pypoe-next/ 308
            forward_auth 127.0.0.1:8009 {
                uri /auth/verify
                copy_headers X-Auth-User X-Auth-Role
            }
            handle_path /pypoe-next/* {
                reverse_proxy 127.0.0.1:8007
            }
        }
        # Hermes Agent dashboard — moved here from gaia 2026-09-18. Loopback-only
        # (hermes-dashboard user unit, :9119); forward_auth is the sole gate.
        # /hermes/api/{ws,pty,events} are EXEMPT from forward_auth: the WebSocket
        # upgrade and SSE stream cannot carry the auth round-trip (same reason as
        # /xarm5/ws on gaia); the dashboard authenticates those itself.
        @hermes_ws path /hermes/api/ws /hermes/api/pty /hermes/api/events
        handle @hermes_ws {
            uri strip_prefix /hermes
            reverse_proxy 127.0.0.1:9119 {
                header_up Host 127.0.0.1
                header_up -Origin
                header_up X-Forwarded-Prefix /hermes
            }
        }
        @hermes {
            path /hermes /hermes/*
            not path /hermes/api/ws /hermes/api/pty /hermes/api/events
        }
        handle @hermes {
            forward_auth 127.0.0.1:8009 {
                uri /auth/verify
                copy_headers X-Auth-User X-Auth-Role
            }
            redir /hermes /hermes/ 308
            handle_path /hermes/* {
                @nonadmin not header X-Auth-Role admin
                respond @nonadmin "The Hermes Agent dashboard is admins-only." 403
                reverse_proxy 127.0.0.1:9119 {
                    header_up Host 127.0.0.1
                    header_up X-Forwarded-Prefix /hermes
                }
            }
        }
        # ---- Device UIs — served from this edge since Phase C (2026-09). Same shape
        # as gaia's edge: forward_auth gates the UI; the /ws path is EXEMPT because
        # the WebSocket upgrade cannot carry the auth round-trip; each device checks
        # a per-device edge secret from EnvironmentFile device-edge-secrets.env.
        @xarm_ui {
            path /xarm5 /xarm5/*
            not path /xarm5/ws
        }
        redir /xarm5 /xarm5/web/ 308
        redir /xarm5/ /xarm5/web/ 308
        redir /xarm5/web /xarm5/web/ 308
        forward_auth @xarm_ui 127.0.0.1:8009 {
            uri /auth/verify
            copy_headers X-Auth-User X-Auth-Role
        }
        handle_path /xarm5/* {
            reverse_proxy sdl2-pc-03-cytation.tail6a1dd7.ts.net:8000 {
                header_up X-Edge-Auth {env.XARM_EDGE_SHARED_SECRET}
            }
        }
        @mg400_ui {
            path /mg400 /mg400/*
            not path /mg400/ws
        }
        redir /mg400 /mg400/web/ 308
        redir /mg400/ /mg400/web/ 308
        redir /mg400/web /mg400/web/ 308
        redir /mg400/ui /mg400/web/ 308
        forward_auth @mg400_ui 127.0.0.1:8009 {
            uri /auth/verify
            copy_headers X-Auth-User X-Auth-Role
        }
        handle_path /mg400/* {
            reverse_proxy sdl2-pc-05-dobot.tail6a1dd7.ts.net:8050 {
                header_up X-Edge-Auth {env.MG400_EDGE_SHARED_SECRET}
            }
        }
        @ot2_hte {
            path /ot2/hte /ot2/hte/*
        }
        redir /ot2/hte /ot2/hte/ui/ 308
        redir /ot2/hte/ /ot2/hte/ui/ 308
        redir /ot2/hte/ui /ot2/hte/ui/ 308
        forward_auth @ot2_hte 127.0.0.1:8009 {
            uri /auth/verify
            copy_headers X-Auth-User X-Auth-Role
        }
        handle_path /ot2/hte/* {
            reverse_proxy sdl2-pc-03-cytation.tail6a1dd7.ts.net:8020 {
                header_up X-Edge-Key {env.OT2_EDGE_SECRET}
            }
        }
        @ot2_complexation {
            path /ot2/complexation /ot2/complexation/*
        }
        redir /ot2/complexation /ot2/complexation/ui/ 308
        redir /ot2/complexation/ /ot2/complexation/ui/ 308
        redir /ot2/complexation/ui /ot2/complexation/ui/ 308
        forward_auth @ot2_complexation 127.0.0.1:8009 {
            uri /auth/verify
            copy_headers X-Auth-User X-Auth-Role
        }
        handle_path /ot2/complexation/* {
            reverse_proxy sdl2-pc-03-cytation.tail6a1dd7.ts.net:8021 {
                header_up X-Edge-Key {env.OT2_EDGE_SECRET}
            }
        }
        # AnaliticaDB (API only, gaia 100.64.254.5:8010) at /analyticadb since
        # 2026-09-19: this edge does the login check and stamps the proxy secret
        # AnaliticaDB trusts (its TRUSTED_PROXY_SECRET). No landing page, so the
        # bare prefix goes to its Swagger UI, which fetches /openapi.json at the
        # origin root (service runs without --root-path), hence that route.
        # Roster path policies (hermes@lab.local) are written against these paths.
        @analyticadb path /analyticadb /analyticadb/* /openapi.json
        handle @analyticadb {
            forward_auth 127.0.0.1:8009 {
                uri /auth/verify
                copy_headers X-Auth-User X-Auth-Role X-Auth-Projects X-Auth-Pi-Projects
            }
            redir /analyticadb /analyticadb/docs 302
            redir /analyticadb/ /analyticadb/docs 302
            handle /openapi.json {
                reverse_proxy 100.64.254.5:8010 {
                    header_up X-Edge-Secret {env.ANALYTICA_EDGE_SECRET}
                }
            }
            handle_path /analyticadb/* {
                reverse_proxy 100.64.254.5:8010 {
                    header_up X-Edge-Secret {env.ANALYTICA_EDGE_SECRET}
                }
            }
        }
        # LaAgenteAnalitica (GraphChat, gaia 100.64.254.5:3000) at /analytica
        # since 2026-09-19. It authenticates users itself against the auth
        # service and its own ws token, so no forward_auth here. /agente/* is
        # kept as an alias: the SPA build bakes in its base (assets, API calls,
        # the yjs WebSocket), so the old prefix must keep working until the
        # frontend is rebuilt with VITE_BASE=/analytica/, and afterwards for
        # old bookmarks (a WebSocket cannot follow a redirect).
        @analytica path /analytica /analytica/*
        handle @analytica {
            redir /analytica /analytica/ 302
            handle_path /analytica/* {
                reverse_proxy 100.64.254.5:3000
            }
        }
        @agente path /agente /agente/*
        handle @agente {
            redir /agente /analytica/ 302
            handle_path /agente/* {
                reverse_proxy 100.64.254.5:3000
            }
        }
		@inventory {
			method GET HEAD
			path /bitacora/inventory/embed /bitacora/inventory/embed/* /bitacora/api/inventory /bitacora/api/inventory/* /bitacora/_next/static/*
		}
		handle @inventory {
			reverse_proxy 127.0.0.1:3001 {
				header_down Cache-Control "no-store"
			}
		}

		@record_metadata path /bitacoradb /bitacoradb/*
		handle @record_metadata {
			route {
				forward_auth 127.0.0.1:8009 {
					uri /auth/verify
					copy_headers X-Auth-User X-Auth-Role X-Auth-Projects X-Auth-Pi-Projects
				}
				uri strip_prefix /bitacoradb
				reverse_proxy 127.0.0.1:8013 {
					header_up X-Edge-Secret {env.BITACORADB_EDGE_SECRET}
					header_down Cache-Control "no-store"
				}
			}
		}
		@record_files path /bitacoradb-files /bitacoradb-files/*
		handle @record_files {
			route {
				forward_auth 127.0.0.1:8009 {
					uri /auth/verify
					copy_headers X-Auth-User X-Auth-Role X-Auth-Projects X-Auth-Pi-Projects
				}
				uri strip_prefix /bitacoradb-files
				reverse_proxy 127.0.0.1:8014 {
					header_up X-Edge-Secret {env.BITACORADB_EDGE_SECRET}
					header_down Cache-Control "no-store"
				}
			}
		}

		@bitacora_beta path /bitacora-beta /bitacora-beta/*
		handle @bitacora_beta {
			route {
				forward_auth 127.0.0.1:8000 {
					uri /api/admin/bitacora-beta
					copy_headers X-Auth-User X-Auth-Role X-Auth-Projects X-Auth-Pi-Projects
				}
				header Cache-Control "private, no-store"
				reverse_proxy 127.0.0.1:13001 {
					header_down Cache-Control "private, no-store"
				}
			}
		}

		
        handle /streams/* {
            respond "Legacy camera stream closed. Refresh the dashboard and sign in." 410
        }
        handle /api/camera-streams/* {
            reverse_proxy 127.0.0.1:8001
        }
        @bambu_staging path /bambu /bambu/*
        handle @bambu_staging {
            route {
                forward_auth 127.0.0.1:8009 {
                    uri /auth/verify
                    copy_headers X-Auth-User X-Auth-Role
                }
                redir /bambu /bambu/ui/ 308
                redir /bambu/ /bambu/ui/ 308
                uri strip_prefix /bambu
                reverse_proxy 127.0.0.1:8012 {
                    header_up X-Edge-Auth {env.BAMBU_EDGE_SHARED_SECRET}
                    header_down Cache-Control "no-store"
                }
            }
        }

        @bitacora path /bitacora /bitacora/*
		handle @bitacora {
			forward_auth 127.0.0.1:8009 {
				uri /auth/verify
				copy_headers X-Auth-User X-Auth-Role X-Auth-Projects X-Auth-Pi-Projects
			}
			reverse_proxy 127.0.0.1:3001 {
				header_down Cache-Control "no-store"
			}
		}

		handle {
			reverse_proxy 127.0.0.1:8000 {
				header_down Cache-Control "no-store"
			}
		}
	}
}

# Future public dashboard origin. Existing localhost:8080 rehearsal remains.
# ---- HTTPS origin on the tailnet name (Phase C1). A DIFFERENT ORIGIN from the
# IP, so it carries its own ac_auth_session cookie — signing in here is a
# separate sign-in. Cert issued by `tailscale cert` (a real Let's Encrypt cert
# via the tailnet's HTTPS-certificates feature), renewed daily by
# caddy-tailscale-cert.timer, NOT Caddy-managed — hence the explicit files and
# the global `auto_https off`. Routes are the shared :8080 router.
https://sdl2-server-agents.tail6a1dd7.ts.net {
    tls /etc/dashboard-staging/certs/sdl2-server-agents.tail6a1dd7.ts.net.crt /etc/dashboard-staging/certs/sdl2-server-agents.tail6a1dd7.ts.net.key
    reverse_proxy 127.0.0.1:8080
}

http://100.64.254.6 {
    bind 100.64.254.6
    reverse_proxy 127.0.0.1:8080
}

# Existing lab auth clients continue using .6:8009 after the address swap.
http://100.64.254.6:8009 {
    bind 100.64.254.6
    request_header -X-Auth-User
    request_header -X-Auth-Role
    request_header -X-Auth-Projects
    request_header -X-Auth-Pi-Projects
    request_header -X-Edge-Secret
    reverse_proxy 127.0.0.1:8009
}

# Uptime Kuma (admin watchdog) — migrated from Gaia to this host 2026-09-18.
# Container binds 127.0.0.1:8005 with its internal auth disabled: this edge IS
# its auth. Same pattern as deploy/Caddyfile.single-edge in ac-organic-lab.
http://100.64.254.6:8005 {
    bind 100.64.254.6
    # `route` fixes the order: Caddy's default directive order runs
    # request_header AFTER forward_auth, which would strip the role that
    # forward_auth just copied in and 403 every admin.
    route {
        request_header -X-Auth-User
        request_header -X-Auth-Role
        forward_auth 127.0.0.1:8009 {
            uri /auth/verify
            copy_headers X-Auth-User X-Auth-Role
        }
        @nonadmin not header X-Auth-Role admin
        respond @nonadmin "Uptime Kuma is admins-only." 403
        reverse_proxy 127.0.0.1:8005
    }
}

# ---------------------------------------------------------------------------
# RETAINED, NOT DEPLOYED — Gibbie Flex operator panel.
#
# Commented out on purpose: this block has no upstream. It was written for a
# Flex control gateway on sdl2-pc-04:8071 that has never existed. Checked on
# the PC 2026-09-20: `netstat` shows :8070 alone in the 80xx range and
# `sc query` lists only gibbie-server, mt-xpr-balance and sdl-lab-hostops;
# GIBBIE_FLEX_EDGE_SECRET is set in no edge env file. Installing it as written
# buys a 502 instead of a 404.
#
# Kept because web/src/lib/device-panels.ts and the gibbie_flex entry in
# equipment.yaml both point here to explain why the dashboard offers no Flex
# control link. When a Flex panel ships: confirm the port, set the secret on
# both sides, uncomment INSIDE the shared :8080 router above (not at top
# level), and restore the gibbie_flex entry in device-panels.ts.
# ---------------------------------------------------------------------------
# 	# Gibbie Flex: NOT DEPLOYED — there is no upstream behind this block.
# 	# It was written alongside a dashboard page that framed it, for a Flex
# 	# control gateway on sdl2-pc-04:8071 that has never existed. Checked on
# 	# the PC 2026-09-20: `netstat` shows :8070 alone in the 80xx range and
# 	# `sc query` lists only gibbie-server, mt-xpr-balance and sdl-lab-hostops.
# 	# GIBBIE_FLEX_EDGE_SECRET is set in no edge env file either. Installing
# 	# this block as it stands buys a 502 instead of a 404, so it stays out of
# 	# the live Caddyfile until that gateway ships — at which point confirm the
# 	# port, set the secret on both sides, and re-point the dashboard by
# 	# restoring the gibbie_flex entry in web/src/lib/device-panels.ts.
# 	# The dashboard therefore offers NO Flex control link today.
# 	@flex_gibbie path /flex/gibbie /flex/gibbie/*
# 	forward_auth @flex_gibbie 100.64.254.6:8009 {
# 		uri /auth/verify
# 		copy_headers X-Auth-User X-Auth-Role
# 	}
# 	redir /flex/gibbie /flex/gibbie/ui/ 308
# 	redir /flex/gibbie/ /flex/gibbie/ui/ 308
# 	redir /flex/gibbie/ui /flex/gibbie/ui/ 308
# 	handle_path /flex/gibbie/* {
# 		reverse_proxy sdl2-pc-04.tail6a1dd7.ts.net:8071 {
# 			# Expand on reload, so adding this secret needs no Caddy restart.
# 			header_up X-Edge-Key {$GIBBIE_FLEX_EDGE_SECRET}
