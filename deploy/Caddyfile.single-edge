# Single-edge SSO login for SDL2 — INTERIM (Phase 1 of docs/SINGLE_EDGE_SSO_PLAN.md).
#
# GOAL: ONE origin — http://100.64.254.6 — is the single place a user signs in.
# Every UI is a *path* under this one origin, so the ac_auth session cookie
# (`ac_auth_session`, host-only) rides on every request to every path. Sign in
# once → reach the dashboard AND every device-native panel. We are NOT sharing a
# cookie across hosts (ts.net's Public Suffix List entry forbids that — see
# AUTH_DESIGN.md "Why sessions can't be shared per-host"); with a single host
# there is nothing to share: one host-only cookie already covers all paths.
#
# PLAIN HTTP on the raw Tailnet IP is deliberate: you cannot get a CA cert for
# 100.64.254.6, so the cookie is non-Secure — the same posture the dashboard
# already runs over the tailnet today. The upgrade path (Phase 3 of the plan) is
# sdl2.accelerationconsortium.ai + a DNS-01 wildcard cert → HTTPS + Secure
# cookie, with the routing below unchanged.
#
# CANONICAL ENTRYPOINT — users MUST reach the lab as http://100.64.254.6/ .
# Hitting the ts.net hostname, or a device host:port directly, is a DIFFERENT
# origin → a different cookie → a second login. Publish only this one URL.
#
#   sudo cp Caddyfile.single-edge /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

http://100.64.254.6 {
	encode gzip

	# ---- camera video + gateway (unchanged; already on this origin) --------
	handle_path /streams/* {
		reverse_proxy 127.0.0.1:1984
	}
	handle /api/cameras/* {
		reverse_proxy 127.0.0.1:8002
	}
	handle /api/plugs/* {
		reverse_proxy 127.0.0.1:8002
	}

	# ---- shared auth surface + banner, on this origin ----------------------
	# ac_auth (:8009) serves the login/session API AND the self-contained top
	# banner asset (GET /auth/banner.js). Every UI includes the banner with one
	# line (<script src="/auth/banner.js">); it and its /auth/me, /auth/login,
	# /auth/verify-code, /auth/users, /auth/logout calls all resolve here on the
	# single origin, so the host-only ac_auth_session cookie rides along. This
	# path is UNgated (it is the login surface). NOTE: /auth/verify is still
	# called internally by the forward_auth blocks below (also to :8009); routing
	# it here too is harmless — same upstream.
	handle /auth/* {
		reverse_proxy 100.64.254.6:8009
	}

	# ---- device-native panels, path-routed ONTO this origin ----------------
	# These are the UIs that used to demand their own login (each on its own
	# origin). forward_auth gates them at the edge against the SAME ac_auth the
	# dashboard uses (100.64.254.6:8009 /auth/verify → 200 + X-Auth-User/Role,
	# else 401). On allow we proxy to the device panel over the tailnet.
	#
	# xArm5 native panel lives at :8000/web/ on the device PC, and its API at the
	# device root (/status, /ws, /control/*). We STRIP ONLY the /xarm5 prefix (no
	# /web rewrite): that way BOTH the panel (canonical URL /xarm5/web/) AND the
	# API (/xarm5/status, /xarm5/ws, /xarm5/control/*) resolve on the device. The
	# panel's assets are relative and its JS derives the /xarm5 base-path from the
	# URL and prefixes its own API/WS calls, so no server-side rewrite is needed
	# (xarm repo: web/main.js, web/graph.js, web/auth.js). Do NOT re-add a
	# `rewrite * /web{uri}` — it would send /xarm5/status to /web/status (404) and
	# an app-level FastAPI root_path breaks the StaticFiles mount under Starlette
	# 1.x. See docs/SINGLE_EDGE_SSO_PLAN.md "xArm /web/ behind the edge".
	#
	# forward_auth authenticates the human at the edge and injects X-Auth-User /
	# X-Auth-Role. `header_up X-Edge-Auth` lets the device trust that identity and
	# drop its own login banner — the device trusts the injected identity ONLY
	# when this shared secret matches, because :8000 is still directly reachable
	# on the Tailnet (a direct caller can't produce the secret). Set the SAME
	# secret on both sides:
	#   edge:   XARM_EDGE_SHARED_SECRET=…  in caddy's systemd EnvironmentFile
	#   device: XARM_EDGE_SHARED_SECRET=…  in the xarm NSSM/service env
	# When Phase 2 lands (loopback-bind / ACL :8000 to the edge only) the secret
	# becomes belt-and-suspenders. Canonical URL to publish: http://100.64.254.6/xarm5/web/
	@xarm_ui path /xarm5 /xarm5/*
	forward_auth @xarm_ui 100.64.254.6:8009 {
		uri /auth/verify
		copy_headers X-Auth-User X-Auth-Role
	}
	# Normalize the entrypoints to the panel's canonical trailing-slash URL.
	# Without this, /xarm5, /xarm5/ and /xarm5/web reach the device at /web,
	# whose StaticFiles issues a slash-redirect to /web/ that DROPS the /xarm5
	# prefix -> the browser lands on the dashboard and 404s. Redirecting at the
	# edge keeps the prefix. (redir is ordered before handle_path in Caddy.)
	redir /xarm5 /xarm5/web/ 308
	redir /xarm5/ /xarm5/web/ 308
	redir /xarm5/web /xarm5/web/ 308
	handle_path /xarm5/* {
		reverse_proxy sdl2-pc-03-cytation.tail6a1dd7.ts.net:8000 {
			header_up X-Edge-Auth {env.XARM_EDGE_SHARED_SECRET}
		}
	}

	# ---- AnaliticaDB results catalog (this host), path-routed ONTO this origin
	# AnaliticaDB (FastAPI) serves the analytical-results catalog + /docs at :8010
	# on this host. handle_path strips /analytica so the service sees its own root
	# paths (/experiments, /docs, …). forward_auth gates every /analytica/* request
	# against the same ac_auth and injects the identity AND the project scope
	# (member/pi projects) the service's can_read consumes. header_up stamps the
	# shared secret so the service trusts those headers — X-Auth-* are honoured
	# ONLY when X-Edge-Secret matches, because :8010 is directly reachable on the
	# Tailnet (a direct caller can't produce the secret; see AnaliticaDB
	# api/deps.py get_caller). Set the SAME secret on both sides, and only once
	# AnaliticaDB flips ENFORCE_AUTHZ on:
	#   edge:    ANALYTICA_EDGE_SECRET=…   in caddy's systemd env
	#   service: TRUSTED_PROXY_SECRET=…    in AnaliticaDB's .env (with ENFORCE_AUTHZ=1)
	# /status + /health carry no caller identity, so the dashboard aggregator keeps
	# polling :8010 directly, unaffected by this route or by enforcement. Full
	# Swagger /docs rendering under the prefix additionally needs `--root-path
	# /analytica` on the uvicorn ExecStart (deferred; raw API paths work without it).
	@analytica path /analytica /analytica/*
	forward_auth @analytica 100.64.254.6:8009 {
		uri /auth/verify
		copy_headers X-Auth-User X-Auth-Role X-Auth-Projects X-Auth-Pi-Projects
	}
	handle_path /analytica/* {
		reverse_proxy 100.64.254.6:8010 {
			header_up X-Edge-Secret {env.ANALYTICA_EDGE_SECRET}
		}
	}

	# ---- LaAgenteAnalitica UI (agent chat, separate PC) --------------------
	# The agent's React/Vite UI runs at 100.64.254.21:8080. Fronting it here
	# gives it the shared /auth/banner.js top bar + the single sign-in cookie
	# (same origin) and publishes one URL: http://100.64.254.6/analitica/ .
	# We pass the /analitica prefix THROUGH (no strip): the SPA must be served
	# with Vite base:'/analitica/' so its own asset + HMR URLs carry the prefix
	# and line up (root-absolute /@vite/client, /*.svg would otherwise 404
	# against the dashboard). Ungated at the edge — the agent keeps its own auth;
	# the shared banner just reflects the session (add forward_auth here later if
	# edge-enforced login is wanted; the app has a forward_auth-edge mode).
	# NOTE: distinct path from /analytica (AnaliticaDB results catalog, :8010).
	@analitica path /analitica /analitica/*
	handle @analitica {
		reverse_proxy 100.64.254.21:8080
	}

	# ---- dashboard (Next.js) at root ---------------------------------------
	# Next.js serves / and /api/* (it rewrites /api/* to FastAPI on :8001) and
	# enforces its own control/assistant gate via web/src/middleware.ts against
	# the same sidecar — so no forward_auth wrapper is needed here.
	reverse_proxy 100.64.254.6:8000
}
