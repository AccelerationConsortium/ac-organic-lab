# Single-edge SSO login for SDL2 — INTERIM (Phase 1 of docs/SINGLE_EDGE_SSO_PLAN.md).
#
# GOAL: ONE origin — http://100.64.254.6 — is the single place a user signs in.
# Every UI is a *path* under this one origin, so the ac_auth session cookie
# (`ac_auth_session`, host-only) rides on every request to every path. Sign in
# once → reach the dashboard AND every device-native panel. We are NOT sharing a
# cookie across hosts (ts.net's Public Suffix List entry forbids that — see
# AUTH_DESIGN.md "Why sessions can't be shared per-host"); with a single host
# there is nothing to share: one host-only cookie already covers all paths.
#
# PLAIN HTTP on the raw Tailnet IP is deliberate: you cannot get a CA cert for
# 100.64.254.6, so the cookie is non-Secure — the same posture the dashboard
# already runs over the tailnet today. The upgrade path (Phase 3 of the plan) is
# sdl2.accelerationconsortium.ai + a DNS-01 wildcard cert → HTTPS + Secure
# cookie, with the routing below unchanged.
#
# CANONICAL ENTRYPOINT — users MUST reach the lab as http://100.64.254.6/ .
# Hitting the ts.net hostname, or a device host:port directly, is a DIFFERENT
# origin → a different cookie → a second login. Publish only this one URL.
#
#   sudo cp Caddyfile.single-edge /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

# Bound config reloads. Without a grace_period Caddy waits FOREVER for open
# connections to finish before retiring the old config — and this origin
# always has long-lived ones (camera MSE/WebRTC streams, dashboard SSE/WS),
# so `systemctl reload caddy` hangs until systemd's timeout and reports
# failure while the old config keeps serving. 10s force-closes stragglers;
# stream players and WS clients reconnect on their own.
{
	grace_period 10s
}

http://100.64.254.6 {
	encode gzip

	# ---- camera video (unchanged; already on this origin) ------------------
	# go2rtc only. The camera/plug gateway (:8002) is deliberately NOT routed
	# at the edge: the browser reaches it exclusively through the dashboard's
	# audited passthrough at /api/equipment/{id}/{control,media}/*
	# (api/app/control.py), which falls through to Next.js at the bottom of
	# this block. Two /api/{cameras,plugs}/* blocks used to sit here as a
	# dev-only escape hatch; they never worked — the gateway mounts
	# /cameras/… and /plugs/… with no /api prefix, so both the edge and the
	# gateway itself answered 404 — while still shadowing those paths from the
	# fallback proxy. Removed 2026-08-02.
	handle_path /streams/* {
		reverse_proxy 127.0.0.1:1984
	}

	# ---- shared auth surface + banner, on this origin ----------------------
	# ac_auth (:8009) serves the login/session API AND the self-contained top
	# banner asset (GET /auth/banner.js). Every UI includes the banner with one
	# line (<script src="/auth/banner.js">); it and its /auth/me, /auth/login,
	# /auth/verify-code, /auth/users, /auth/logout calls all resolve here on the
	# single origin, so the host-only ac_auth_session cookie rides along. This
	# path is UNgated (it is the login surface). NOTE: /auth/verify is still
	# called internally by the forward_auth blocks below (also to :8009); routing
	# it here too is harmless — same upstream.
	handle /auth/* {
		reverse_proxy 100.64.254.6:8009
	}

	# ---- device-native panels, path-routed ONTO this origin ----------------
	# These are the UIs that used to demand their own login (each on its own
	# origin). forward_auth gates them at the edge against the SAME ac_auth the
	# dashboard uses (100.64.254.6:8009 /auth/verify → 200 + X-Auth-User/Role,
	# else 401). On allow we proxy to the device panel over the tailnet.
	#
	# xArm5 native panel lives at :8000/web/ on the device PC, and its API at the
	# device root (/status, /ws, /control/*). We STRIP ONLY the /xarm5 prefix (no
	# /web rewrite): that way BOTH the panel (canonical URL /xarm5/web/) AND the
	# API (/xarm5/status, /xarm5/ws, /xarm5/control/*) resolve on the device. The
	# panel's assets are relative and its JS derives the /xarm5 base-path from the
	# URL and prefixes its own API/WS calls, so no server-side rewrite is needed
	# (xarm repo: web/main.js, web/graph.js, web/auth.js). Do NOT re-add a
	# `rewrite * /web{uri}` — it would send /xarm5/status to /web/status (404) and
	# an app-level FastAPI root_path breaks the StaticFiles mount under Starlette
	# 1.x. See docs/SINGLE_EDGE_SSO_PLAN.md "xArm /web/ behind the edge".
	#
	# forward_auth authenticates the human at the edge and injects X-Auth-User /
	# X-Auth-Role. `header_up X-Edge-Auth` lets the device trust that identity and
	# drop its own login banner — the device trusts the injected identity ONLY
	# when this shared secret matches, because :8000 is still directly reachable
	# on the Tailnet (a direct caller can't produce the secret). Set the SAME
	# secret on both sides:
	#   edge:   XARM_EDGE_SHARED_SECRET=…  in caddy's systemd EnvironmentFile
	#   device: XARM_EDGE_SHARED_SECRET=…  in the xarm NSSM/service env
	# When Phase 2 lands (loopback-bind / ACL :8000 to the edge only) the secret
	# becomes belt-and-suspenders. Canonical URL to publish: http://100.64.254.6/xarm5/web/
	# /xarm5/ws is EXEMPT from forward_auth: Caddy forwards the WebSocket
	# Connection/Upgrade headers to the auth subrequest, and Starlette answers
	# an upgrade on a route with no WS handler with a bare 403 before any
	# cookie check — so every WS through the edge died at /auth/verify, even
	# logged-in (verified live 2026-08-02: plain GET /xarm5/status → 401,
	# same with WS headers → 403; :8009/auth/verify shows the same pair).
	# Ungating it adds no exposure while :8000 is directly reachable on the
	# tailnet (Phase 2 pending) — /ws is read-only telemetry either way.
	@xarm_ui {
		path /xarm5 /xarm5/*
		not path /xarm5/ws
	}
	forward_auth @xarm_ui 100.64.254.6:8009 {
		uri /auth/verify
		copy_headers X-Auth-User X-Auth-Role
	}
	# Normalize the entrypoints to the panel's canonical trailing-slash URL.
	# Without this, /xarm5, /xarm5/ and /xarm5/web reach the device at /web,
	# whose StaticFiles issues a slash-redirect to /web/ that DROPS the /xarm5
	# prefix -> the browser lands on the dashboard and 404s. Redirecting at the
	# edge keeps the prefix. (redir is ordered before handle_path in Caddy.)
	redir /xarm5 /xarm5/web/ 308
	redir /xarm5/ /xarm5/web/ 308
	redir /xarm5/web /xarm5/web/ 308
	handle_path /xarm5/* {
		reverse_proxy sdl2-pc-03-cytation.tail6a1dd7.ts.net:8000 {
			header_up X-Edge-Auth {env.XARM_EDGE_SHARED_SECRET}
		}
	}

	# ---- Opentrons OT-2 gateway operator UIs, path-routed ONTO this origin --
	# opentrons-server (device PC sdl2-pc-03-cytation) serves an operator SPA
	# at /ui, edge-gated: /ui and /labware return 404 unless the request carries
	# header X-Edge-Key matching the gateway's OT2_EDGE_SECRET. When the key is
	# valid the gateway ALSO trusts header X-Auth-User and stamps it into the
	# claim owner (details.claimed_by.owner), so a "Take control" in the browser
	# records the logged-in person. /, /health, /status, /control/* are NOT
	# gated — the aggregator keeps polling them DIRECTLY on the device port
	# (equipment.yaml base_url → :8020 / :8021), so these routes do not change
	# how the dashboard reaches the OT-2s.
	#
	# Two instances on the same device PC: ot2_hte on :8020, ot2_complexation
	# on :8021. handle_path strips the /ot2/{hte,complexation} prefix so the
	# upstream sees its OWN /ui, /labware paths (the SPA was built to live at
	# /ui). Canonical URLs to publish: /ot2/hte/ui/ and /ot2/complexation/ui/.
	#
	# Prefix-safe as of opentrons-server (vite base "./" + a runtime apiBase):
	# assets resolve RELATIVE to the page URL, and the SPA derives its API
	# prefix by stripping the trailing /ui segment of its own path — so one
	# build serves both instances through their own prefixes, with no
	# per-instance rebuild. (Before that, the SPA's absolute /ui/assets/...
	# paths resolved against the edge root and only the HTML loaded.) The
	# dashboard's OT-2 tile links straight here (new tab); see
	# web/src/lib/device-panels.ts, which mirrors these route blocks.
	#
	# forward_auth gates the human at the edge (same ac_auth) and injects
	# X-Auth-User via copy_headers. header_up in the reverse_proxy SETS
	# X-Edge-Key (overwriting any client-supplied value with the shared
	# secret), so a direct caller can't forge it — same overwrite pattern
	# as the /xarm5 and /analytica blocks (which also strip nothing).
	# We deliberately do NOT use `request_header -X-Auth-User` to strip a
	# client-supplied value: Caddy's fixed directive order runs
	# `request_header` AFTER `forward_auth`, so a strip there would remove
	# the X-Auth-User forward_auth just injected. `copy_headers` overwrites
	# the client value, which is the protection we want. Set the SAME secret
	# on both sides:
	#   edge:   OT2_EDGE_SECRET=…  in caddy's systemd EnvironmentFile
	#   device: OT2_EDGE_SECRET=…  in each gateway's NSSM AppEnvironmentExtra
	#     (read it on the device PC with:
	#      nssm get ot2-gateway-hte AppEnvironmentExtra, and
	#      nssm get ot2-gateway-complexation AppEnvironmentExtra)
	# The secret is NOT in git. Direct device-port /ui stays 404 (no X-Edge-Key).
	@ot2_hte path /ot2/hte /ot2/hte/*
	forward_auth @ot2_hte 100.64.254.6:8009 {
		uri /auth/verify
		copy_headers X-Auth-User X-Auth-Role
	}
	redir /ot2/hte /ot2/hte/ui/ 308
	redir /ot2/hte/ /ot2/hte/ui/ 308
	redir /ot2/hte/ui /ot2/hte/ui/ 308
	handle_path /ot2/hte/* {
		reverse_proxy sdl2-pc-03-cytation.tail6a1dd7.ts.net:8020 {
			header_up X-Edge-Key {env.OT2_EDGE_SECRET}
		}
	}

	@ot2_complexation path /ot2/complexation /ot2/complexation/*
	forward_auth @ot2_complexation 100.64.254.6:8009 {
		uri /auth/verify
		copy_headers X-Auth-User X-Auth-Role
	}
	redir /ot2/complexation /ot2/complexation/ui/ 308
	redir /ot2/complexation/ /ot2/complexation/ui/ 308
	redir /ot2/complexation/ui /ot2/complexation/ui/ 308
	handle_path /ot2/complexation/* {
		reverse_proxy sdl2-pc-03-cytation.tail6a1dd7.ts.net:8021 {
			header_up X-Edge-Key {env.OT2_EDGE_SECRET}
		}
	}

	# ---- AnaliticaDB results catalog (this host), path-routed ONTO this origin
	# AnaliticaDB (FastAPI) serves the analytical-results catalog + /docs at :8010
	# on this host. handle_path strips /analytica so the service sees its own root
	# paths (/experiments, /docs, …). forward_auth gates every /analytica/* request
	# against the same ac_auth and injects the identity AND the project scope
	# (member/pi projects) the service's can_read consumes. header_up stamps the
	# shared secret so the service trusts those headers — X-Auth-* are honoured
	# ONLY when X-Edge-Secret matches, because :8010 is directly reachable on the
	# Tailnet (a direct caller can't produce the secret; see AnaliticaDB
	# api/deps.py get_caller). Set the SAME secret on both sides, and only once
	# AnaliticaDB flips ENFORCE_AUTHZ on:
	#   edge:    ANALYTICA_EDGE_SECRET=…   in caddy's systemd env
	#   service: TRUSTED_PROXY_SECRET=…    in AnaliticaDB's .env (with ENFORCE_AUTHZ=1)
	# /status + /health carry no caller identity, so the dashboard aggregator keeps
	# polling :8010 directly, unaffected by this route or by enforcement. Full
	# Swagger /docs rendering under the prefix additionally needs `--root-path
	# /analytica` on the uvicorn ExecStart (deferred; raw API paths work without it).
	@analytica path /analytica /analytica/*
	forward_auth @analytica 100.64.254.6:8009 {
		uri /auth/verify
		copy_headers X-Auth-User X-Auth-Role X-Auth-Projects X-Auth-Pi-Projects
	}
	handle_path /analytica/* {
		reverse_proxy 100.64.254.6:8010 {
			header_up X-Edge-Secret {env.ANALYTICA_EDGE_SECRET}
		}
	}

	# ---- LaAgenteAnalitica UI (agent chat, on THIS host: gaia) --------------
	# GraphChat now runs locally at 127.0.0.1:3000 in GRAPHCHAT_AUTH_MODE=ac_auth,
	# so the app verifies the shared ac_auth_session cookie itself (it is NOT
	# edge-gated here, unlike the old separate-PC forward_auth setup). The cookie
	# rides along because /agente shares this 100.64.254.6 origin; the shared
	# /auth/banner.js top bar rides on top. handle_path STRIPS /agente: the
	# backend serves the SPA + API at its root and the frontend was built with a
	# matching base (VITE_BASE=/agente/) so browser URLs carry the prefix the edge
	# strips back off. WebSocket upgrades proxy through the same handle_path
	# (Caddy auto-handles Upgrade); the app authenticates the socket via its own
	# short-lived ws_token. Distinct path from /analytica (AnaliticaDB, :8010).
	redir /agente /agente/ 308
	handle_path /agente/* {
		reverse_proxy 127.0.0.1:3000
	}

	# ---- PyPoe web UI, path-routed ONTO this origin (banner only, NOT gated) --
	# PyPoe (:8006 on this host) is pulled onto the single edge so it carries the
	# shared /auth/banner.js banner and the host-only ac_auth_session cookie rides
	# along (one sign-in for the whole lab). Deliberately NO forward_auth yet —
	# "carry the banner first, enforce next" (AUTH_DESIGN.md → "Policy: every web
	# service carries the central auth"). handle_path strips /pypoe so
	# PyPoe sees its own root paths; header_up X-Forwarded-Prefix tells PyPoe to
	# prefix the URLs it emits (assets / links / API / WS) so they resolve back
	# under /pypoe (_ForwardedPrefixMiddleware → base_path() /
	# window.PYPOE_BASE). /auth/* is NOT under this prefix — it resolves at the
	# edge root above, so the banner + its /auth/me,/login,… calls are same-origin.
	# WebSocket (/ws/chat/*) proxies through unblocked (no forward_auth to exclude
	# Upgrade from). Canonical URL: http://100.64.254.6/pypoe/
	redir /pypoe /pypoe/ 308
	handle_path /pypoe/* {
		reverse_proxy 100.64.254.6:8006 {
			header_up X-Forwarded-Prefix /pypoe
		}
	}

	# ---- PyPoe React preview (parallel-deploy migration) — banner-only -------
	# The new React UI runs as pypoe-web-next on :8007 alongside the Jinja UI on
	# :8006, sharing the DB. Its base path is BAKED INTO the Vite build
	# (VITE_BASE=/pypoe-next/), so no X-Forwarded-Prefix is needed — handle_path
	# just strips /pypoe-next and the backend serves /assets, /api, /status at
	# root. No forward_auth (banner-only, same as /pypoe). Retire this block at
	# cutover, when /pypoe/ is flipped to :8007. See pypoe docs/REACT_UI_MIGRATION.md.
	redir /pypoe-next /pypoe-next/ 308
	handle_path /pypoe-next/* {
		reverse_proxy 100.64.254.6:8007
	}

	# ---- bitacora (agentic ELN), path-routed ONTO this origin ---------------
	# The ELN is a separate Next.js app on :3001, framed by the dashboard's
	# /workflows tab. It is built with `basePath: /bitacora` and proxies
	# /bitacora/api/* -> :8050 itself, so the prefix must reach it INTACT:
	# `handle`, never `handle_path` (which strips the prefix the app expects).
	# forward_auth gates it through the same ac_auth as every other surface.
	#
	# MUST stay above the root reverse_proxy below. Caddy matches in order, and
	# the catch-all otherwise swallows /bitacora/* and answers with the
	# dashboard's own 404 — which, being same-origin, renders the whole dashboard
	# inside the Workflows iframe and 404s every ELN asset.
	#
	# THIS BLOCK LIVES HERE ON PURPOSE. Installing this file overwrites
	# /etc/caddy/Caddyfile wholesale, so a route kept only as a hand-edit there is
	# silently destroyed by the next edge deploy — which is exactly what happened
	# on 2026-08-02 (three edge fixes that evening; the ELN 404'd until someone
	# opened the tab). One file, one owner.
	@bitacora path /bitacora /bitacora/*
	forward_auth @bitacora 100.64.254.6:8009 {
		uri /auth/verify
		# X-Auth-Projects / X-Auth-Pi-Projects are load-bearing, not extra: the ELN
		# forwards them to AnaliticaDB, whose read rule is `admin OR PI OR active
		# member`, and which learns membership from these headers alone. Without
		# them every non-admin reaches the record layer with an empty scope, so a
		# project's own PI sees none of their runs (measured 2026-08-14). The
		# AnaliticaDB route below already copies them; this one did not.
		copy_headers X-Auth-User X-Auth-Role X-Auth-Projects X-Auth-Pi-Projects
	}
	handle @bitacora {
		# Same no-store override as the dashboard route: Next.js defaults HTML
		# to a 1-year cache, which pins the chunk hashes the HTML references.
		# Static chunks under /_next/static/ keep their own immutable cache.
		@bitacora_html not path /bitacora/_next/static/* /bitacora/api/*
		reverse_proxy @bitacora_html 127.0.0.1:3001 {
			header_down Cache-Control "private, no-cache, no-store, max-age=0, must-revalidate"
		}
		reverse_proxy 127.0.0.1:3001
	}

	# ---- Hermes Agent web dashboard (this host), path-routed ONTO this origin
	# The Hermes dashboard (FastAPI + React SPA) runs at 127.0.0.1:9119 on gaia,
	# loopback-only — Caddy's forward_auth is its sole gate. handle_path strips
	# /hermes so the SPA sees its own root paths (/assets/*, /api/*, /login, …).
	# forward_auth gates every /hermes/* request against ac_auth and injects the
	# identity headers; on 401 the browser redirects to / (the lab dashboard's
	# email+code login), same as every other edge-gated panel.
	#
	# /hermes/api/ws is EXEMPT from forward_auth: the Chat tab uses a WebSocket
	# upgrade, and forward_auth sends the Upgrade headers to ac_auth's /auth/verify
	# which answers 403 before the WS handshake completes (same issue as /xarm5/ws).
	# The WS is authenticated by the dashboard's own session token, not the cookie.
	# Canonical URL: http://100.64.254.6/hermes/
	@hermes_ws path /hermes/api/ws
	handle @hermes_ws {
		reverse_proxy 127.0.0.1:9119 {
			header_up Host 127.0.0.1
			header_up X-Forwarded-Prefix /hermes
		}
	}
	@hermes {
		path /hermes /hermes/*
		not path /hermes/api/ws
	}
	forward_auth @hermes 100.64.254.6:8009 {
		uri /auth/verify
		copy_headers X-Auth-User X-Auth-Role
	}
	redir /hermes /hermes/ 308
	handle_path /hermes/* {
		reverse_proxy 127.0.0.1:9119 {
			header_up Host 127.0.0.1
			header_up X-Forwarded-Prefix /hermes
		}
	}

	# ---- dashboard (Next.js) at root ---------------------------------------
	# Next.js serves / and /api/* (it rewrites /api/* to FastAPI on :8001) and
	# enforces its own control/assistant gate via web/src/middleware.ts against
	# the same sidecar — so no forward_auth wrapper is needed here.
	#
	# Override Next.js's default 1-year HTML cache (s-maxage=31536000) with
	# no-store on HTML documents only. The cached HTML pins the iframe src and
	# chunk hashes it references, so a dashboard redeploy looks stale until a
	# hard reload — the /workflows iframe kept serving an old bitacora build
	# this way. Static chunks under /_next/static/ keep their own immutable
	# cache (the matcher excludes them).
	@dashboard_html not path /_next/static/* /api/* /streams/*
	reverse_proxy @dashboard_html 100.64.254.6:8000 {
		header_down Cache-Control "private, no-cache, no-store, max-age=0, must-revalidate"
	}
	# Static assets and API: no header override (pass through upstream's own).
	reverse_proxy 100.64.254.6:8000
}

# ---- Uptime Kuma (admin watchdog) — SSO edge on its own PORT ---------------
# Kuma cannot be served under a sub-path (upstream limitation), so it gets its
# own port on the canonical host instead: cookies are port-agnostic, so the
# ac_auth_session cookie set on http://100.64.254.6/ rides along to :8005.
# The container binds 127.0.0.1:8005 (UPTIME_KUMA_HOST); this edge site owns
# 100.64.254.6:8005, so the dashboard's existing "Open" link keeps working.
# Admins only: any lab account can authenticate, but only role=admin passes
# (X-Auth-Role is set by forward_auth from the verify response — a client-
# supplied copy is overwritten, so the matcher below is trustworthy). Kuma's
# internal auth is disabled (Settings → Advanced) — this edge IS its auth.
# PyPoe keeps reading the anonymous status-page API on loopback, under this
# gate. Requires AUTH_LOGIN_URL to be ABSOLUTE in the sidecar env, or the
# logged-out redirect would loop on this origin.
http://100.64.254.6:8005 {
	# Bind the Tailnet IP specifically — Caddy's default wildcard listener
	# (*:8005) would block the Kuma container from binding 127.0.0.1:8005.
	bind 100.64.254.6
	forward_auth 100.64.254.6:8009 {
		uri /auth/verify
		copy_headers X-Auth-User X-Auth-Role
	}
	@nonadmin not header X-Auth-Role admin
	respond @nonadmin "Uptime Kuma is admins-only." 403
	reverse_proxy 127.0.0.1:8005
}
