# Point-in-time snapshot of the live dashboard history DB for the boxed
# hermes agent. See /usr/local/bin/lab-history-snapshot.sh for why a snapshot
# is used instead of granting access to the live WAL database.
[Unit]
Description=Snapshot lab history DB for the boxed hermes agent (read-only)
After=ac-dashboard-staging-api.service

[Service]
Type=oneshot
User=sdl2
Group=sdl2
ExecStart=/usr/local/bin/lab-history-snapshot.sh
# Never compete with the live dashboard for disk.
Nice=10
IOSchedulingClass=idle
