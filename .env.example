# Copy to .env and fill in. Both files are gitignored.
# v1 is read-only and does not require any secrets to run.

# Path to the equipment registry. Defaults to ../equipment.yaml relative to api/.
# LAB_REGISTRY_PATH=/abs/path/to/equipment.yaml

# Path to the lab history SQLite database.
# Defaults to <repo-root>/data/lab.db  (created automatically on first run).
# LAB_DB_PATH=/opt/ac-organic-dashboard/data/lab.db

# Origin allowed by FastAPI CORS (browser only talks to the dashboard origin).
# In dev, leave the default (localhost). In prod, set to your tailscale URL.
# DASHBOARD_CORS_ORIGINS=http://localhost:3000,https://lab-dashboard.tail-XXXX.ts.net

# Future control-plane secrets (none used in v1):
# CONTROL_API_TOKEN=
# ALERT_WEBHOOK_URL=
